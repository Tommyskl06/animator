{"data":{"deltas":[{"range":{"end":{"character":0,"line":222},"start":{"character":0,"line":2}},"text":"import builtins\nimport data\nimport drawing\nimport editor\nimport errors\nimport gleam/dict.{type Dict}\nimport gleam/float\nimport gleam/int\nimport gleam/list\nimport gleam/result\nimport gleam/string\nimport lustre\nimport lustre/attribute as attr\nimport lustre/effect.{type Effect}\nimport lustre/element.{type Element}\nimport lustre/element/html\nimport lustre/event\nimport parser\nimport render\nimport shape.{type Path}\n\n/// Your app's public address, once you've deployed it in Problem 13, such as\n/// \"https://your-username.github.io/animator/\".\npub const public_url = \"\"\n\n/// Set to True if you would like your app's URL included in the course gallery.\npub const include_app_in_gallery = False\n\n/// A link to your video from Problem 14, which anyone with the link can watch.\npub const video_url = \"\"\n\n/// Set to True if you would like your video included in the course gallery.\npub const include_video_in_gallery = False\n\nconst default_code = \"fn draw(shape_slider: Int) -> List(Path) {\\n  [Path(Line(Point(0, 0), Point(100, 100)), 0, 10, 2)]\\n}\\n\"\n\n// ── Model ──────────────────────────────────────────────────────────────────────\n\npub type Model {\n  Model(\n    // The code in the editor.\n    source: String,\n    // Whether the code editor is shown.\n    code_open: Bool,\n    output: String,\n    // Problem 10: Control panel state\n    shape_slider: Int,\n    speed: Float,\n    // Problem 11: Drawing Library\n    active_drawing: String,\n    drawings: Dict(String, String),\n  )\n}\n\npub type Msg {\n  SetCode(String)\n  // Layout controls\n  ToggleCode\n  // Problem 10: Slider controls\n  SetShapeSlider(Int)\n  SetSpeed(Float)\n  // Problem 11: Library controls\n  SelectDrawing(String)\n  CreateDrawing\n}\n\n// ── Init ───────────────────────────────────────────────────────────────────────\n\npub fn init(_flags: Nil) -> #(Model, Effect(Msg)) {\n  let lib = data.load_library()\n  let current_source = case dict.get(lib.drawings, lib.active) {\n    Ok(code) -> code\n    Error(_) -> default_code\n  }\n\n  #(\n    Model(\n      source: current_source,\n      code_open: True,\n      output: \"\",\n      shape_slider: 10,\n      speed: 1.0,\n      active_drawing: lib.active,\n      drawings: lib.drawings,\n    ),\n    effect.batch([\n      editor.mount(current_source, SetCode),\n      effect.from(fn(dispatch) { dispatch(SetCode(current_source)) }),\n    ]),\n  )\n}\n\n// Parse and evaluate a draw function at the given shape-slider value, returning\n// the rendered paths on success, or a human-readable message on failure.\nfn run_source(shape_slider: Int, source: String) -> Result(List(Path), String) {\n  case parser.parse_program(source, builtins.global_frame()) {\n    Error(msg) -> Error(msg)\n    Ok(program) ->\n      drawing.try_draw(shape_slider, program)\n      // Convert Error(EvalError) to Error(String) with a useful error message.\n      |> result.map_error(errors.error_message)\n  }\n}\n\n// ── Update ─────────────────────────────────────────────────────────────────────\n\npub fn update(model: Model, msg: Msg) -> #(Model, Effect(Msg)) {\n  case msg {\n    ToggleCode -> #(Model(..model, code_open: !model.code_open), effect.none())\n\n    // 每次编辑器有按键改动时，直接更新状态并写入 localStorage\n    SetCode(text) -> {\n      let #(output_text, render_paths) =\n        evaluate_and_render(model.shape_slider, text)\n      render.set_drawing(render_paths)\n\n      let updated_drawings = dict.insert(model.drawings, model.active_drawing, text)\n      let new_model = Model(\n        ..model,\n        source: text,\n        output: output_text,\n        drawings: updated_drawings,\n      )\n      \n      // 持久化到 localStorage\n      data.save_library(data.Library(active: new_model.active_drawing, drawings: updated_drawings))\n\n      #(new_model, effect.none())\n    }\n\n    SetShapeSlider(val) -> {\n      let #(output_text, render_paths) = evaluate_and_render(val, model.source)\n      render.set_drawing(render_paths)\n\n      #(\n        Model(..model, output: output_text, shape_slider: val),\n        effect.none(),\n      )\n    }\n\n    SetSpeed(spd) -> {\n      render.set_speed(spd)\n      #(Model(..model, speed: spd), effect.none())\n    }\n\n    SelectDrawing(name) -> {\n      case name {\n        // value 为 \"\" 时代表用户点击了 \"New Drawing...\" 选项\n        \"\" -> update(model, CreateDrawing)\n        _ -> {\n          case dict.get(model.drawings, name) {\n            Ok(code) -> {\n              let #(output_text, render_paths) = evaluate_and_render(model.shape_slider, code)\n              render.set_drawing(render_paths)\n\n              let new_model = Model(\n                ..model,\n                active_drawing: name,\n                source: code,\n                output: output_text,\n              )\n              data.save_library(data.Library(active: name, drawings: model.drawings))\n\n              #(new_model, editor.mount(code, SetCode))\n            }\n            Error(_) -> #(model, effect.none())\n          }\n        }\n      }\n    }\n\n    CreateDrawing -> {\n      let new_name = data.prompt_drawing_name()\n      case new_name {\n        \"\" -> #(model, effect.none()) // 用户取消了输入\n        _ -> {\n          let updated_drawings = dict.insert(model.drawings, new_name, default_code)\n          let #(output_text, render_paths) = evaluate_and_render(model.shape_slider, default_code)\n          render.set_drawing(render_paths)\n\n          let new_model = Model(\n            ..model,\n            active_drawing: new_name,\n            source: default_code,\n            output: output_text,\n            drawings: updated_drawings,\n          )\n          data.save_library(data.Library(active: new_name, drawings: updated_drawings))\n\n          #(new_model, editor.mount(default_code, SetCode))\n        }\n      }\n    }\n  }\n}\n\nfn evaluate_and_render(\n  shape_slider: Int,\n  source: String,\n) -> #(String, List(render.RenderPath)) {\n  case run_source(shape_slider, source) {\n    Ok(paths) -> {\n      let r_paths = list.map(paths, fn(p) { render.render_path(p, \"black\") })\n      #(string.inspect(paths), r_paths)\n    }\n    Error(msg) -> #(msg, [])\n  }\n}\n\n// ── View ──────────────────────────────────────────────────────────────────\n\npub fn view(model: Model) -> Element(Msg) {\n  let app_class = case model.code_open {\n    True -> \"app\"\n    False -> \"app code-hidden\"\n  }\n\n  html.div([attr.class(app_class)], [\n    html.div([attr.class(\"code-col\")], [\n      editor.view_panel(ToggleCode),\n    ]),\n    view_anim(model),\n  ])\n}\n\nfn view_anim(model: Model) -> Element(Msg) {\n  html.div([attr.class(\"canvas-area\")], [\n    view_reveal_code(model),\n    view_controls(model),\n    html.canvas([\n      attr.id(\"animation-canvas\"),\n      attr.class(\"canvas\"),\n    ]),\n    html.pre([attr.class(\"output\")], [html.text(model.output)]),\n  ])\n}\n\nfn view_controls(model: Model) -> Element(Msg) {\n  html.div([attr.class(\"controls\")], [\n    // Problem 11: 图纸下拉选择框\n    html.label([], [\n      html.text(\"Drawing: \"),\n      html.select(\n        [\n          attr.attribute(\"data-test-id\", \"drawing-select\"),\n          event.on_change(SelectDrawing),\n        ],\n        // 生成所有的图纸选项\n        list.concat([\n          list.map(dict.to_list(model.drawings), fn(pair) {\n            let #(name, _) = pair\n            html.option(\n              [\n                attr.value(name),\n                attr.selected(name == model.active_drawing),\n              ],\n              name,\n            )\n          }),\n          // 新建选项（注意：value 必须设为 \"\" 以便测试识别跳过）\n          [\n            html.option(\n              [attr.value(\"\")],\n              \"+ New Drawing...\",\n            ),\n          ],\n        ]),\n      ),\n    ]),\n\n    // Shape Slider\n    html.label([], [\n      html.text(\" Shape: \"),\n      html.input([\n        attr.type_(\"range\"),\n        attr.min(\"0\"),\n        attr.max(\"100\"),\n        attr.value(int.to_string(model.shape_slider)),\n        attr.attribute(\"data-test-id\", \"shape-slider\"),\n        event.on_input(fn(val) {\n          case int.parse(val) {\n            Ok(n) -> SetShapeSlider(n)\n            Error(_) -> SetShapeSlider(model.shape_slider)\n          }\n        }),\n      ]),\n    ]),\n\n    // Speed Slider\n    html.label([], [\n      html.text(\" Speed: \"),\n      html.input([\n        attr.type_(\"range\"),\n        attr.min(\"-2.0\"),\n        attr.max(\"2.0\"),\n        attr.step(\"0.1\"),\n        attr.value(float.to_string(model.speed)),\n        attr.attribute(\"data-test-id\", \"speed-slider\"),\n        event.on_input(fn(val) {\n          case float.parse(val) {\n            Ok(s) -> SetSpeed(s)\n            Error(_) -> SetSpeed(model.speed)\n          }\n        }),\n      ]),\n    ]),\n  ])\n}\n\nfn view_reveal_code(model: Model) -> Element(Msg) {\n  case model.code_open {\n    True -> element.none()\n    False ->\n      html.button(\n        [\n          attr.class(\"icon-btn reveal-code\"),\n          attr.attribute(\"title\", \"Show code\"),\n          event.on_click(ToggleCode),\n        ],\n        [html.text(\"⟩\")],\n      )\n  }\n}\n\n// ── Main ───────────────────────────────────────────────────────────────────────\n\npub fn main() -> Nil {\n  let app = lustre.application(init, update, view)\n  let assert Ok(_) = lustre.start(app, \"#app\", Nil)\n  Nil\n}"}],"path":"src/app.gleam","source":"paste_likely"},"hash":"201709e46db97fef9aa4fd937d85c4c0542443e919207c0f84254512dcf46ec5","kind":"doc.change","prev_hash":"d3d48f2c88a58d1e10cdaf36060310afcb48d50df9ed6312668749c838e846b6","seq":1136,"t":14615595,"wall":"2026-11-11T02:57:22.997Z"}
