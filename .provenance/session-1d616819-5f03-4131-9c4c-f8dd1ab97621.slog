{"data":{"deltas":[{"range":{"end":{"character":1,"line":122},"start":{"character":0,"line":105}},"text":"pub fn view(model: Model) -> Element(Msg) {\n  let app_class = case model.code_open {\n    True -> \"app\"\n    False -> \"app code-hidden\"\n  }\n  // The code column still exists even when hidden (CSS collapses it) so the\n  // mounted CodeMirror editor keeps its state across show/hide.\n  html.div([attr.class(app_class)], [\n    html.div([attr.class(\"code-col\")], [\n      editor.view_panel(ToggleCode),\n    ]),\n    view_anim(model),\n  ])\n}"}],"path":"src/app.gleam","source":"paste_likely"},"hash":"dac87e8441d87533bc8a4190f7f6d998b64efbc59449c7ac9735c107d38cf2ff","kind":"doc.change","prev_hash":"369b5b0f286d941699471517166575960de82894c7ee503e5b0f5658812fb2e9","seq":154,"t":3134854,"wall":"2026-11-10T23:46:00.142Z"}
