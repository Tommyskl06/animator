{"data":{"deltas":[{"range":{"end":{"character":1,"line":99},"start":{"character":0,"line":80}},"text":"pub fn update(model: Model, msg: Msg) -> #(Model, Effect(Msg)) {\n  case msg {\n    ToggleCode -> #(Model(..model, code_open: !model.code_open), effect.none())\n\n    // After each keystroke in the editor, evaluate user code and report errors.\n    SetCode(text) -> {\n      let #(output_text, render_paths) = case run_source(10, text) {\n        // Parsed and evaluated: show the result and map paths to RenderPath\n        Ok(paths) -> {\n          let r_paths = list.map(paths, fn(p) { render.render_path(p, p.color) })\n          #(string.inspect(paths), r_paths)\n        }\n        // Broken (parse or evaluation): show the error and clear paths\n        Error(msg) -> #(msg, [])\n      }\n\n      // 核心修改 1：根据题目要求，每次代码改变（哪怕是空路径或有语法错误），\n      // 都必须统一调用 render.set_drawing(render_paths)\n      render.set_drawing(render_paths)\n\n      #(\n        Model(..model, output: output_text, source: text),\n        effect.none(),\n      )\n    }\n  }\n}"}],"path":"src/app.gleam","source":"paste_likely"},"hash":"67df6bcfa0bb236ca0c4d86374bd78433f70ce9e85b18823cd14de849cdf0163","kind":"doc.change","prev_hash":"8f1ab931d2fca6fec1458f83a30d08381ae60e5cdc34deb43df294d0e8a14560","seq":236,"t":3524043,"wall":"2026-11-10T23:52:29.313Z"}
