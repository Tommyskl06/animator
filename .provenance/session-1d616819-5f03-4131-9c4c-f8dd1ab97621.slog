{"data":{"deltas":[{"range":{"end":{"character":1,"line":113},"start":{"character":0,"line":93}},"text":"pub fn update(model: Model, msg: Msg) -> #(Model, Effect(Msg)) {\n  case msg {\n    ToggleCode -> #(Model(..model, code_open: !model.code_open), effect.none())\n\n    // After each keystroke in the editor, evaluate user code and report errors.\n    SetCode(text) -> {\n      let #(output_text, render_paths) =\n        evaluate_and_render(model.shape_slider, text)\n      render.set_drawing(render_paths)\n\n      #(\n        Model(..model, output: output_text, source: text),\n        effect.none(),\n      )\n    }\n\n    SetShapeSlider(val) -> {\n      let #(output_text, render_paths) = evaluate_and_render(val, model.source)\n      render.set_drawing(render_paths)\n\n      #(\n        Model(..model, output: output_text, shape_slider: val),\n        effect.none(),\n      )\n    }\n\n    SetSpeed(spd) -> {\n      // 改变速度时仅调用 render.set_speed，不修改 drawing\n      render.set_speed(spd)\n\n      #(\n        Model(..model, speed: spd),\n        effect.none(),\n      )\n    }\n  }\n}\n\nfn evaluate_and_render(\n  shape_slider: Int,\n  source: String,\n) -> #(String, List(render.RenderPath)) {\n  case run_source(shape_slider, source) {\n    Ok(paths) -> {\n      let r_paths = list.map(paths, fn(p) { render.render_path(p, \"black\") })\n      #(string.inspect(paths), r_paths)\n    }\n    Error(msg) -> #(msg, [])\n  }\n}"}],"path":"src/app.gleam","source":"paste_likely"},"hash":"33f69e42ae9f39f3bef5190f44c56b10e4b5ee2cb8f6fe2180599e64a4645edf","kind":"doc.change","prev_hash":"c88fe31add34d0eb1d5bf0b13601cf84e4e48f4730d6aaac512499ed383e82f7","seq":590,"t":4455389,"wall":"2026-11-11T00:08:00.615Z"}
