{"data":{"deltas":[{"range":{"end":{"character":1,"line":304},"start":{"character":0,"line":235}},"text":"fn view_controls(model: Model) -> Element(Msg) {\n  html.div([attr.class(\"controls\")], [\n    // Problem 11: Drawing select dropdown\n    html.select(\n      [\n        attr.attribute(\"data-test-id\", \"drawing-select\"),\n        event.on_change(SelectDrawing),\n      ],\n      list.flatten([\n        list.map(dict.to_list(model.drawings), fn(pair) {\n          let #(name, _) = pair\n          html.option(\n            [\n              attr.value(name),\n              attr.selected(name == model.active_drawing),\n            ],\n            name,\n          )\n        }),\n        [\n          html.option(\n            [attr.value(\"\")],\n            \"+ New Drawing...\",\n          ),\n        ],\n      ]),\n    ),\n\n    // Shape Slider\n    html.input([\n      attr.type_(\"range\"),\n      attr.min(\"0\"),\n      attr.max(\"100\"),\n      attr.value(int.to_string(model.shape_slider)),\n      attr.attribute(\"data-test-id\", \"shape-slider\"),\n      event.on_input(fn(val) {\n        case int.parse(val) {\n          Ok(n) -> SetShapeSlider(n)\n          Error(_) -> SetShapeSlider(model.shape_slider)\n        }\n      }),\n    ]),\n\n    // Speed Slider\n    html.input([\n      attr.type_(\"range\"),\n      attr.min(\"-2.0\"),\n      attr.max(\"2.0\"),\n      attr.step(\"0.1\"),\n      attr.value(float.to_string(model.speed)),\n      attr.attribute(\"data-test-id\", \"speed-slider\"),\n      event.on_input(fn(val) {\n        case float.parse(val) {\n          Ok(s) -> SetSpeed(s)\n          Error(_) -> SetSpeed(model.speed)\n        }\n      }),\n    ]),\n  ])\n}"}],"path":"src/app.gleam","source":"paste_likely"},"hash":"d75e249d191dde80b066a3eb3a20dbf3ebe0d98aabef014bd2f063d2f3dfc628","kind":"doc.change","prev_hash":"ba9039bb11e1c2cdcd10264fd15203d6b879036bb0dbedab16f81fc511819cec","seq":1546,"t":17702157,"wall":"2026-11-11T03:48:49.555Z"}
