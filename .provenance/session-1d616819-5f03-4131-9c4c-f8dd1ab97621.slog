{"data":{"deltas":[{"range":{"end":{"character":1,"line":118},"start":{"character":0,"line":105}},"text":"fn view(model: Model) -> element.Element(Msg) {\n  html.div([], [\n    // 1. 保留原有的代码编辑器 view_panel\n    editor.view_panel(model.editor),\n    \n    // 2. 添加测试所必需的 animation-canvas 画布元素\n    html.canvas([\n      html.id(\"animation-canvas\"),\n      html.class(\"canvas\"),\n    ]),\n    \n    // 3. 错误信息显示区域（当求值出错时提示用户）\n    case model.error_message {\n      Some(err) -> html.div([html.class(\"error-display\")], [html.text(err)])\n      None -> html.text(\"\")\n    }\n  ])\n}"}],"path":"src/app.gleam","source":"paste_likely"},"hash":"5040e981e1c59290bafaaaa06cd065afcf20add3043f617aaf548b8a77306262","kind":"doc.change","prev_hash":"315320a85bb3630406f052e9c41fcbaaf2a01d1b7fdc44f306bd77a4c8eef9e7","seq":149,"t":3090673,"wall":"2026-11-10T23:45:15.963Z"}
