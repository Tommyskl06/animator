{"data":{"deltas":[{"range":{"end":{"character":1,"line":71},"start":{"character":0,"line":62}},"text":"pub fn init(_flags: Nil) -> #(Model, Effect(Msg)) {\n  #(\n    Model(\n      source: \"\",\n      code_open: True,\n      output: \"\",\n      shape_slider: 10,\n      speed: 1.0,\n    ),\n    // Effects that happen automatically at the start go here.\n    effect.batch([\n      editor.mount(default_code, SetCode),\n      effect.from(fn(dispatch) { dispatch(SetCode(default_code)) }),\n    ]),\n  )\n}"}],"path":"src/app.gleam","source":"paste_likely"},"hash":"78ad40a433924ad0e4306e14b802d0079559165b97bf757527bd7b3ee99d94ae","kind":"doc.change","prev_hash":"c968bd178799ddb0de68fb5108845edcfb988527250c7efbecb617d3b0b41fa3","seq":543,"t":4410640,"wall":"2026-11-11T00:07:15.868Z"}
