{"data":{"deltas":[{"range":{"end":{"character":1,"line":89},"start":{"character":0,"line":81}},"text":"fn run_source(shape_slider: Int, source: String) -> Result(List(Path), String) {\n  case parser.parse_program(source, builtins.global_frame()) {\n    Error(msg) -> Error(msg)\n    Ok(program) ->\n      drawing.try_draw(shape_slider, program)\n      // Convert Error(EvalError) to Error(String) with a useful error message.\n      |> result.map_error(errors.error_message)\n  }\n}"}],"path":"src/app.gleam","source":"paste_likely"},"hash":"e84c078be28b24dedc4064181857b713e5489c051fdbad280b057e79cddf950a","kind":"doc.change","prev_hash":"9294c06448bf28c3a9d2b9cfe24e4b3686bb16d9c9bcaad059fefd74bb55d9b7","seq":558,"t":4432692,"wall":"2026-11-11T00:07:37.919Z"}
