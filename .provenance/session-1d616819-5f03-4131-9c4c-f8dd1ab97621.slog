{"data":{"deltas":[{"range":{"end":{"character":1,"line":93},"start":{"character":0,"line":71}},"text":"pub fn init(_flags: Nil) -> #(Model, Effect(Msg)) {\n  let lib: data.Library = data.load_library()\n  let current_source = case dict.get(lib.drawings, lib.active) {\n    Ok(code) -> code\n    Error(_) -> default_code\n  }\n\n  #(\n    Model(\n      source: current_source,\n      code_open: True,\n      output: \"\",\n      shape_slider: 10,\n      speed: 1.0,\n      active_drawing: lib.active,\n      drawings: lib.drawings,\n    ),\n    effect.batch([\n      editor.mount(current_source, SetCode),\n      effect.from(fn(dispatch) { dispatch(SetCode(current_source)) }),\n    ]),\n  )\n}"}],"path":"src/app.gleam","source":"paste_likely"},"hash":"63ebd4adb681bcbd82d63dcdc9d6ad5a8a07d98832f000ae3bd38ec2416141af","kind":"doc.change","prev_hash":"b63a4e25f68678f7f3161deeeec6225bc62a5cf155855b2022704222f979e94e","seq":1651,"t":17917360,"wall":"2026-11-11T03:52:24.757Z"}
