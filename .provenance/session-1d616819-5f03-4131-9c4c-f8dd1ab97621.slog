{"data":{"content":"// The browser features behind data.gleam.\n\nimport { Result$Ok, Result$Error } from \"./gleam.mjs\";\n\n// localStorage can throw: when the browser blocks it for this site, or (on a\n// write) when the site is out of space.\nexport function storageGet(key) {\n  try {\n    const value = globalThis.localStorage.getItem(key);\n    return value === null ? Result$Error(undefined) : Result$Ok(value);\n  } catch {\n    return Result$Error(undefined);\n  }\n}\n\nexport function storageSet(key, value) {\n  try {\n    globalThis.localStorage.setItem(key, value);\n  } catch (error) {\n    console.error(`Couldn't save: ${error.message}`);\n  }\n}\n\n// Ask the user to name a new drawing; \"\" (empty string) means they cancelled.\nexport function promptDrawingName() {\n  const name = window.prompt(\"Name for the new drawing:\");\n  return name === null ? \"\" : name;\n}\n","line_count":29,"path":"src/data_ffi.mjs","sha256":"6cf5bd60cf99773738ad32a80d445602741fbe46ef69b262f51ed0670f43e6ab"},"hash":"d2f89134a1f3974fa796096788848f7eb6327f5f5f58a1489755baac75eeb5ab","kind":"doc.open","prev_hash":"2d21173d7717dcf4229da26c4abe0e3a9e30ce8a5ceadf7eff0dbdc0f1aed48a","seq":1697,"t":18076373,"wall":"2026-11-11T03:55:03.771Z"}
