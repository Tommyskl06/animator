{"data":{"deltas":[{"range":{"end":{"character":1,"line":558},"start":{"character":0,"line":521}},"text":"/// 🎮 辅助函数：从实际渲染路径列表中根据 Seed 随机抽样挑选一个顶点的坐标\nfn pick_target_from_paths(paths: List(render.RenderPath), seed: Int) -> #(Float, Float) {\n  let len = list.length(paths)\n  case len {\n    0 -> #(250.0, 250.0)\n    _ -> {\n      let index = seed % len\n      let path_list = list.drop(paths, index)\n      case list.first(path_list) {\n        // RenderPath.start 是 Point(x, y)，坐标为相对中心 (-250 ~ 250)，需要加上 250 转回 Canvas 坐标\n        Ok(path) -> #(path.start.x +. 250.0, path.start.y +. 250.0)\n        Error(_) -> #(250.0, 250.0)\n      }\n    }\n  }\n}\n\n/// 🎮 辅助函数：计算鼠标坐标到当前所有青色线条起点/终点轨道的最小距离\nfn get_min_dist_to_paths(mx: Float, my: Float, paths: List(render.RenderPath)) -> Float {\n  let cx = mx -. 250.0\n  let cy = my -. 250.0\n\n  case paths {\n    [] -> 0.0\n    _ -> {\n      list.fold(paths, 999999.0, fn(acc_min, path) {\n        let dx = cx -. path.start.x\n        let dy = cy -. path.start.y\n        let dist = float.square_root(dx *. dx +. dy *. dy) |> result.unwrap(9999.0)\n        case dist <. acc_min {\n          True -> dist\n          False -> acc_min\n        }\n      })\n    }\n  }\n}"}],"path":"src/app.gleam","source":"paste_likely"},"hash":"35f9a3992d680a379445263576b02c29df047bcf9619357ae4a230255d55eac8","kind":"doc.change","prev_hash":"2fa7fa16300bd3346b1db4cb92d98b2fd2c352db80526bf5d9f9404bd6c5c456","seq":2309,"t":22151818,"wall":"2026-11-12T00:34:37.076Z"}
