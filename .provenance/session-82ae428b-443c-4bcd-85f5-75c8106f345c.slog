{"data":{"deltas":[{"range":{"end":{"character":0,"line":544},"start":{"character":0,"line":526}},"text":"/// 🎮 辅助函数：从路径列表中获取准确的 $(x, y)$ 端点坐标 (带防越界处理)\nfn pick_target_from_paths(paths: List(render.RenderPath), seed: Int) -> #(Float, Float) {\n  let len = list.length(paths)\n  case len {\n    0 -> #(250.0, 250.0)\n    _ -> {\n      let index = seed % len\n      let path_list = list.drop(paths, index)\n      case list.first(path_list) {\n        Ok(path) -> {\n          // 将 RenderPath 的起点映射回 Canvas 绝对坐标 (250 + start, 250 + end)\n          // 加上防超出边缘边界约束 (50.0 ~ 450.0)\n          let raw_x = 250.0 +. path.start\n          let raw_y = 250.0 +. path.end\n          let clamped_x = float.max(60.0, float.min(440.0, raw_x))\n          let clamped_y = float.max(60.0, float.min(440.0, raw_y))\n          #(clamped_x, clamped_y)\n        }\n        Error(_) -> #(250.0, 250.0)\n      }\n    }\n  }\n}"}],"path":"src/app.gleam","source":"paste_likely"},"hash":"03c4983fd45087a589a849d3c51546f15ec03f159a3f272409440fe6f112dec6","kind":"doc.change","prev_hash":"02a8da961907db7540f8e64b5d8768d40b67587c888c1d2edff3fa3816c68487","seq":2413,"t":22589402,"wall":"2026-11-12T00:41:54.661Z"}
