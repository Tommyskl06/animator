{"data":{"deltas":[{"range":{"end":{"character":1,"line":635},"start":{"character":0,"line":611}},"text":"fn point_to_segment_dist(\n  px: Float,\n  py: Float,\n  x1: Float,\n  y1: Float,\n  x2: Float,\n  y2: Float,\n) -> Float {\n  let dx = x2 -. x1\n  let dy = y2 -. y1\n  let len_sq = dx *. dx +. dy *. dy\n  let t = case len_sq ==. 0.0 {\n    True -> 0.0\n    False -> {\n      let raw_t = { { px -. x1 } *. dx +. { py -. y1 } *. dy } /. len_sq\n      float.max(0.0, float.min(1.0, raw_t))\n    }\n  }\n  let proj_x = x1 +. t *. dx\n  let proj_y = y1 +. t *. dy\n  let dist_x = px -. proj_x\n  let dist_y = py -. proj_y\n  float.square_root(dist_x *. dist_x +. dist_y *. dist_y)\n  |> result.unwrap(9999.0)\n}"}],"path":"src/app.gleam","source":"paste_likely"},"hash":"e6a8e93b8aac1e23460867b47b59e969175a6e61cb5d458a452c658cfadfc0a7","kind":"doc.change","prev_hash":"e018d608112b65c62e612c51daca2dd50e9486bb3f9f3c52be180305d005cd07","seq":3019,"t":31755897,"wall":"2026-11-12T03:14:41.117Z"}
