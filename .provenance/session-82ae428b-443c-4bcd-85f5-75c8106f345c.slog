{"data":{"deltas":[{"range":{"end":{"character":1,"line":263},"start":{"character":0,"line":247}},"text":"fn view_anim(model: Model) -> Element(Msg) {\n  html.div([attr.class(\"canvas-area\")], [\n    view_reveal_code(model),\n    view_controls(model), \n    html.canvas([\n      attr.id(\"animation-canvas\"),\n      attr.class(\"canvas\"),\n      // 🎮 使用 dynamic 解码器精准提取 event.offsetX 和 event.offsetY\n      event.on(\"mousemove\", fn(event_obj) {\n        let mouse_decoder =\n          dynamic.decode2(\n            fn(x, y) { UpdateMousePos(x, y) },\n            dynamic.field(\"offsetX\", dynamic.float),\n            dynamic.field(\"offsetY\", dynamic.float),\n          )\n\n        case mouse_decoder(event_obj) {\n          Ok(msg) -> msg\n          Error(_) -> UpdateMousePos(model.mouse_x, model.mouse_y)\n        }\n      }),\n    ]),\n    html.pre([attr.class(\"output\")], [html.text(model.output)]),\n  ])\n}"}],"path":"src/app.gleam","source":"paste_likely"},"hash":"5d8310cda83602fa0be189ad92a5c0eafa56aa5f4ea1601814f50081efbc25e2","kind":"doc.change","prev_hash":"81d083d6351ad723da9cb75338acd2f1e4caf9c727a5a1e5ea5a6cb98539407b","seq":1099,"t":13393404,"wall":"2026-11-11T22:08:38.665Z"}
