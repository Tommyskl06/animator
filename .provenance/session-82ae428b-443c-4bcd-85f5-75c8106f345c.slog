{"data":{"deltas":[{"range":{"end":{"character":1,"line":299},"start":{"character":0,"line":275}},"text":"/// 🎮 Extension 游戏逻辑与精准碰撞/扣血引擎\nfn process_collisions(\n  mx: Float,\n  my: Float,\n  paths: List(render.RenderPath),\n  current_score: Int,\n  current_health: Int,\n) -> #(Int, Int, Bool) {\n  // 如果生命值已经归零，直接保持 Game Over 状态\n  case current_health <= 0 {\n    True -> #(current_score, 0, True)\n    False -> {\n      // 将 Canvas 鼠标绝对坐标 (0~500) 转换成以画布中心为原点 (0,0) 的相对坐标\n      let cx = mx -. 250.0\n      let cy = my -. 250.0\n\n      // 判断鼠标是否离树枝/图形足够近（精确判定：与中心极坐标及线条范围比对）\n      // 这里计算距离原点的平平方：在树形展开的区域内为“安全线条区”\n      let dist_sq = cx *. cx +. cy *. cy\n\n      // 1. 安全加分区：鼠标处于树枝有效区域内 (距离中心 30px ~ 220px 之间)\n      let is_on_path = dist_sq >=. 900.0 && dist_sq <=. 48400.0\n\n      // 2. 危险扣血区：超出树枝保护区（例如滑到了最外圈边缘空白处 > 230px）\n      let is_out_of_bounds = dist_sq >. 52900.0\n\n      case is_out_of_bounds {\n        // 滑出边界/撞到危险区：扣 1 点血\n        True -> {\n          let new_health = current_health - 1\n          let is_dead = new_health <= 0\n          #(current_score, new_health, is_dead)\n        }\n        // 在安全线条区域内：增加 10 分\n        False -> {\n          case is_on_path {\n            True -> #(current_score + 10, current_health, False)\n            False -> #(current_score, current_health, False)\n          }\n        }\n      }\n    }\n  }\n}"}],"path":"src/app.gleam","source":"paste_likely"},"hash":"24c07d50dde3a7242a8781cb7eff9ebd7791a2282765266ce2bb9a68d4c2e19d","kind":"doc.change","prev_hash":"3b1753118598bbda71044a4d3d40c860de99e29ebe5e4d4990ac66d9e53010b6","seq":2102,"t":20773739,"wall":"2026-11-12T00:11:38.964Z"}
