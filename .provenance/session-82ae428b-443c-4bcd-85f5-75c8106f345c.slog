{"data":{"deltas":[{"range":{"end":{"character":5,"line":311},"start":{"character":4,"line":232}},"text":"// 🎮 鼠标移动：基于实际线条路径 (RenderPath) 的轨道跟踪与目标收集\n    UpdateMousePos(x, y) -> {\n      case model.game_over {\n        True -> #(model, effect.none())\n        False -> {\n          let current_cd = case model.cooldown_ticks > 0 {\n            True -> model.cooldown_ticks - 1\n            False -> 0\n          }\n\n          // 1. 判定是否触碰到黄色目标点 (距离 < 25px)\n          let dx = x -. model.target_x\n          let dy = y -. model.target_y\n          let hit_target = { dx *. dx +. dy *. dy } <=. 625.0\n\n          let #(new_score, next_tx, next_ty, msg_collected) = case hit_target {\n            True -> {\n              let ns = model.score + 50\n              // 从当前的 render_paths 列表中挑选一个新的真实顶点作为目标\n              let #(tx, ty) = pick_target_from_paths(model.current_paths, ns)\n              #(ns, tx, ty, \"✨ TARGET COLLECTED! (+50)\")\n            }\n            False -> #(model.score, model.target_x, model.target_y, model.status_msg)\n          }\n\n          // 2. 计算鼠标到所有青色线条轨道的最小距离 (Canvas 中心点为 250, 250)\n          let min_dist_to_lines = get_min_dist_to_paths(x, y, model.current_paths)\n\n          // 如果鼠标距离最近的线条 > 35 像素，且距离 Canvas 中心不太远 (防止移出界外)，判为脱轨\n          let is_off_track = min_dist_to_lines >. 35.0 && x >. 10.0 && x <. 490.0 && y >. 10.0 && y <. 490.0\n\n          let #(final_health, final_cd, final_msg, is_dead) = case is_off_track && current_cd == 0 {\n            True -> {\n              let nh = model.health - 1\n              case nh <= 0 {\n                True -> #(0, 0, \"💥 GAME OVER!\", True)\n                False -> #(nh, 30, \"⚠️ OFF TRACK! (-1 HP)\", False) // 脱轨扣血并给予无敌保护\n              }\n            }\n            False -> #(model.health, current_cd, msg_collected, model.health <= 0)\n          }\n\n          #(\n            Model(\n              ..model,\n              mouse_x: x,\n              mouse_y: y,\n              score: new_score,\n              health: final_health,\n              game_over: is_dead,\n              cooldown_ticks: final_cd,\n              status_msg: final_msg,\n              target_x: next_tx,\n              target_y: next_ty,\n            ),\n            effect.none(),\n          )\n        }\n      }\n    }"}],"path":"src/app.gleam","source":"paste_likely"},"hash":"8f43911e1a4880c6acdfe20e6f04c92790a4ad944297d40017ffbbcaa2e579cc","kind":"doc.change","prev_hash":"9d64821de26891098742fd9139ab701555f0d3b19930d0faea36d4fb9af0608c","seq":2264,"t":22036670,"wall":"2026-11-12T00:32:41.928Z"}
