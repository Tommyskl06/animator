{"data":{"deltas":[{"range":{"end":{"character":1,"line":517},"start":{"character":0,"line":0}},"text":"//// Animator -- extension game logic with smooth particle collection & hit cooldown.\n\nimport builtins\nimport data\nimport drawing\nimport editor\nimport errors\nimport gleam/dict.{type Dict}\nimport gleam/dynamic/decode\nimport gleam/float\nimport gleam/int\nimport gleam/list\nimport gleam/result\nimport gleam/string\nimport lustre\nimport lustre/attribute as attr\nimport lustre/effect.{type Effect}\nimport lustre/element.{type Element}\nimport lustre/element/html\nimport lustre/event\nimport parser\nimport render\nimport shape.{type Path}\n\npub const public_url = \"https://github.com/Tommyskl06/animator\"\npub const include_app_in_gallery = True\npub const video_url = \"\"\npub const include_video_in_gallery = False\n\nconst default_code =\n  \"fn draw(shape_slider: Int) -> List(Path) {\\n  [Path(Line(Point(0, 0), Point(100, 100)), 0, 10, 2)]\\n}\\n\"\n\n// ── Model ──────────────────────────────────────────────────────────────────────\n\npub type Model {\n  Model(\n    source: String,\n    code_open: Bool,\n    output: String,\n    shape_slider: Int,\n    speed: Float,\n    active_drawing: String,\n    drawings: Dict(String, String),\n    // 🎮 Extension State\n    mouse_x: Float,\n    mouse_y: Float,\n    score: Int,\n    health: Int,\n    game_over: Bool,\n    // 扣血冷却指示器 (防止秒死)，计数器或防抖\n    cooldown_ticks: Int,\n    // 提示信息 (如 \"⚠️ OUCH! (-1 HP)\")\n    status_msg: String,\n    // 内部目标收集点列表 (Canvas 相对坐标 dx, dy)\n    target_x: Float,\n    target_y: Float,\n    current_paths: List(render.RenderPath),\n  )\n}\n\npub type Msg {\n  SetCode(String)\n  ToggleCode\n  SetShapeSlider(Int)\n  SetSpeed(Float)\n  SelectDrawing(String)\n  CreateDrawing\n  UpdateMousePos(Float, Float)\n  ResetGame\n}\n\n// ── Init ───────────────────────────────────────────────────────────────────────\n\npub fn init(_flags: Nil) -> #(Model, Effect(Msg)) {\n  let lib: data.Library = data.load_library()\n  let current_source = case dict.get(lib.drawings, lib.active) {\n    Ok(code) -> code\n    Error(_) -> default_code\n  }\n\n  let #(_, initial_paths) = evaluate_and_render(10, current_source)\n\n  #(\n    Model(\n      source: current_source,\n      code_open: True,\n      output: \"\",\n      shape_slider: 10,\n      speed: 1.0,\n      active_drawing: lib.active,\n      drawings: lib.drawings,\n      mouse_x: 0.0,\n      mouse_y: 0.0,\n      score: 0,\n      health: 3,\n      game_over: False,\n      cooldown_ticks: 0,\n      status_msg: \"Collect yellow target dots!\",\n      // 初始金点放在图形中心附近 (250, 200)\n      target_x: 250.0,\n      target_y: 200.0,\n      current_paths: initial_paths,\n    ),\n    effect.batch([\n      editor.mount(current_source, SetCode),\n      effect.from(fn(dispatch) { dispatch(SetCode(current_source)) }),\n    ]),\n  )\n}\n\nfn run_source(shape_slider: Int, source: String) -> Result(List(Path), String) {\n  case parser.parse_program(source, builtins.global_frame()) {\n    Error(msg) -> Error(msg)\n    Ok(program) ->\n      drawing.try_draw(shape_slider, program)\n      |> result.map_error(errors.error_message)\n  }\n}\n\n// ── Update ─────────────────────────────────────────────────────────────────────\n\npub fn update(model: Model, msg: Msg) -> #(Model, Effect(Msg)) {\n  case msg {\n    ToggleCode -> #(Model(..model, code_open: !model.code_open), effect.none())\n\n    SetCode(text) -> {\n      let #(output_text, render_paths) =\n        evaluate_and_render(model.shape_slider, text)\n      render.set_drawing(render_paths)\n\n      let updated_drawings =\n        dict.insert(model.drawings, model.active_drawing, text)\n      let new_model =\n        Model(\n          ..model,\n          source: text,\n          output: output_text,\n          drawings: updated_drawings,\n          current_paths: render_paths,\n        )\n\n      data.save_library(data.Library(\n        active: new_model.active_drawing,\n        drawings: updated_drawings,\n      ))\n\n      #(new_model, effect.none())\n    }\n\n    SetShapeSlider(val) -> {\n      let #(output_text, render_paths) = evaluate_and_render(val, model.source)\n      render.set_drawing(render_paths)\n      #(\n        Model(\n          ..model,\n          output: output_text,\n          shape_slider: val,\n          current_paths: render_paths,\n        ),\n        effect.none(),\n      )\n    }\n\n    SetSpeed(spd) -> {\n      render.set_speed(spd)\n      #(Model(..model, speed: spd), effect.none())\n    }\n\n    SelectDrawing(name) -> {\n      case name {\n        \"\" -> update(model, CreateDrawing)\n        _ -> {\n          case dict.get(model.drawings, name) {\n            Ok(code) -> {\n              let #(output_text, render_paths) =\n                evaluate_and_render(model.shape_slider, code)\n              render.set_drawing(render_paths)\n\n              let new_model =\n                Model(\n                  ..model,\n                  active_drawing: name,\n                  source: code,\n                  output: output_text,\n                  current_paths: render_paths,\n                )\n              data.save_library(data.Library(\n                active: name,\n                drawings: model.drawings,\n              ))\n\n              #(new_model, editor.mount(code, SetCode))\n            }\n            Error(_) -> #(model, effect.none())\n          }\n        }\n      }\n    }\n\n    CreateDrawing -> {\n      let new_name = data.prompt_drawing_name()\n      case new_name {\n        \"\" -> #(model, effect.none())\n        _ -> {\n          let updated_drawings =\n            dict.insert(model.drawings, new_name, default_code)\n          let #(output_text, render_paths) =\n            evaluate_and_render(model.shape_slider, default_code)\n          render.set_drawing(render_paths)\n\n          let new_model =\n            Model(\n              ..model,\n              active_drawing: new_name,\n              source: default_code,\n              output: output_text,\n              drawings: updated_drawings,\n              current_paths: render_paths,\n            )\n          data.save_library(data.Library(\n            active: new_name,\n            drawings: updated_drawings,\n          ))\n\n          #(new_model, editor.mount(default_code, SetCode))\n        }\n      }\n    }\n\n    // 🎮 鼠标移动：触发目标收集判定与带无敌冷却的损伤控制\n    UpdateMousePos(x, y) -> {\n      case model.game_over {\n        True -> #(model, effect.none())\n        False -> {\n          // 1. 递减无敌冷却时间\n          let current_cd = case model.cooldown_ticks > 0 {\n            True -> model.cooldown_ticks - 1\n            False -> 0\n          }\n\n          // 2. 检查是否成功吃到了金点目标 (距离小于 30px)\n          let dx = x -. model.target_x\n          let dy = y -. model.target_y\n          let hit_target = { dx *. dx +. dy *. dy } <=. 900.0\n\n          let #(new_score, next_tx, next_ty, msg_collected) = case hit_target {\n            True -> {\n              // 吃到金点加 50 分，并将下一个点概率重置到图形的其它支点\n              let ns = model.score + 50\n              // 算法变换生成下一个内部点坐标\n              let next_x = 250.0 +. float.from_int({ ns * 37 } % 180 - 90)\n              let next_y = 250.0 +. float.from_int({ ns * 53 } % 180 - 90)\n              #(ns, next_x, next_y, \"✨ TARGET COLLECTED! (+50)\")\n            }\n            False -> #(model.score, model.target_x, model.target_y, model.status_msg)\n          }\n\n          // 3. 检查偏离图形的安全边界判定 (只有在 Canvas 极度偏远的空白深处才判定偏离)\n          let dist_from_center = {\n            let cx = x -. 250.0\n            let cy = y -. 250.0\n            cx *. cx +. cy *. cy\n          }\n\n          // 远离中心 230px 外（极边缘深黑处）视为危险撞墙区\n          let is_out_danger = dist_from_center >. 52900.0\n\n          let #(final_health, final_cd, final_msg, is_dead) = case is_out_danger && current_cd == 0 {\n            True -> {\n              let nh = model.health - 1\n              case nh <= 0 {\n                True -> #(0, 0, \"💥 GAME OVER!\", True)\n                False -> #(nh, 25, \"⚠️ OUCH! (-1 HP)\", False) // 触发 25 次事件的无敌冷却\n              }\n            }\n            False -> #(model.health, current_cd, msg_collected, model.health <= 0)\n          }\n\n          #(\n            Model(\n              ..model,\n              mouse_x: x,\n              mouse_y: y,\n              score: new_score,\n              health: final_health,\n              game_over: is_dead,\n              cooldown_ticks: final_cd,\n              status_msg: final_msg,\n              target_x: next_tx,\n              target_y: next_ty,\n            ),\n            effect.none(),\n          )\n        }\n      }\n    }\n\n    // 🎮 重置游戏\n    ResetGame -> {\n      #(\n        Model(\n          ..model,\n          score: 0,\n          health: 3,\n          game_over: False,\n          cooldown_ticks: 0,\n          status_msg: \"Game Reset! Find the yellow dot.\",\n          target_x: 250.0,\n          target_y: 200.0,\n        ),\n        effect.none(),\n      )\n    }\n  }\n}\n\nfn evaluate_and_render(\n  shape_slider: Int,\n  source: String,\n) -> #(String, List(render.RenderPath)) {\n  case run_source(shape_slider, source) {\n    Ok(paths) -> {\n      let r_paths = list.map(paths, fn(p) { render.render_path(p, \"#00ffff\") })\n      #(string.inspect(paths), r_paths)\n    }\n    Error(msg) -> #(msg, [])\n  }\n}\n\n// ── View ──────────────────────────────────────────────────────────────────\n\npub fn view(model: Model) -> Element(Msg) {\n  let app_class = case model.code_open {\n    True -> \"app\"\n    False -> \"app code-hidden\"\n  }\n\n  html.div([attr.class(app_class)], [\n    html.div([attr.class(\"code-col\")], [\n      editor.view_panel(ToggleCode),\n    ]),\n    view_anim(model),\n  ])\n}\n\nfn view_anim(model: Model) -> Element(Msg) {\n  let mouse_decoder = {\n    use x <- decode.field(\"offsetX\", decode.float)\n    use y <- decode.field(\"offsetY\", decode.float)\n    decode.success(UpdateMousePos(x, y))\n  }\n\n  html.div([attr.class(\"canvas-area\"), attr.style(\"position\", \"relative\")], [\n    view_reveal_code(model),\n    view_game_stats(model),\n    view_controls(model),\n    \n    // 🌟 在 Canvas 上添加动态生成的金色收集目标点 (Gold Target Dot)\n    html.div(\n      [\n        attr.style(\"position\", \"absolute\"),\n        attr.style(\"left\", float.to_string(model.target_x -. 10.0) <> \"px\"),\n        attr.style(\"top\", float.to_string(model.target_y -. 10.0) <> \"px\"),\n        attr.style(\"width\", \"20px\"),\n        attr.style(\"height\", \"20px\"),\n        attr.style(\"background\", \"#ffd700\"),\n        attr.style(\"border-radius\", \"50%\"),\n        attr.style(\"box-shadow\", \"0 0 12px #ffd700\"),\n        attr.style(\"pointer-events\", \"none\"),\n        attr.style(\"z-index\", \"5\"),\n      ],\n      [],\n    ),\n\n    html.canvas([\n      attr.id(\"animation-canvas\"),\n      attr.class(\"canvas\"),\n      attr.style(\"pointer-events\", \"auto\"),\n      attr.style(\"cursor\", \"crosshair\"),\n      event.on(\"mousemove\", mouse_decoder),\n    ]),\n    html.pre([attr.class(\"output\")], [html.text(model.output)]),\n  ])\n}\n\nfn view_game_stats(model: Model) -> Element(Msg) {\n  html.div(\n    [\n      attr.style(\"position\", \"absolute\"),\n      attr.style(\"top\", \"10px\"),\n      attr.style(\"right\", \"20px\"),\n      attr.style(\"z-index\", \"10\"),\n      attr.style(\"background\", \"rgba(15, 23, 42, 0.85)\"),\n      attr.style(\"padding\", \"8px 14px\"),\n      attr.style(\"border-radius\", \"6px\"),\n      attr.style(\"color\", \"white\"),\n      attr.style(\"font-size\", \"14px\"),\n      attr.style(\"font-family\", \"sans-serif\"),\n      attr.style(\"display\", \"flex\"),\n      attr.style(\"align-items\", \"center\"),\n      attr.style(\"gap\", \"12px\"),\n      attr.style(\"border\", \"1px solid rgba(255, 255, 255, 0.1)\"),\n    ],\n    [\n      html.span([attr.style(\"font-weight\", \"bold\"), attr.style(\"color\", \"#4ade80\")], [\n        html.text(\"Score: \" <> int.to_string(model.score)),\n      ]),\n      html.span([attr.style(\"color\", \"#f87171\")], [\n        html.text(\"Health: \" <> int.to_string(model.health)),\n      ]),\n      html.span([attr.style(\"color\", \"#fbbf24\"), attr.style(\"font-weight\", \"bold\")], [\n        html.text(model.status_msg),\n      ]),\n      html.button(\n        [\n          attr.class(\"icon-btn\"),\n          attr.style(\"padding\", \"3px 10px\"),\n          attr.style(\"background\", \"#3b82f6\"),\n          attr.style(\"color\", \"white\"),\n          attr.style(\"border\", \"none\"),\n          attr.style(\"border-radius\", \"4px\"),\n          attr.style(\"cursor\", \"pointer\"),\n          event.on_click(ResetGame),\n        ],\n        [html.text(\"Restart\")],\n      ),\n    ],\n  )\n}\n\nfn view_controls(model: Model) -> Element(Msg) {\n  html.div(\n    [\n      attr.class(\"controls\"),\n      attr.style(\"position\", \"absolute\"),\n      attr.style(\"bottom\", \"20px\"),\n      attr.style(\"right\", \"20px\"),\n      attr.style(\"z-index\", \"10\"),\n      attr.style(\"background\", \"rgba(15, 23, 42, 0.85)\"),\n      attr.style(\"padding\", \"12px\"),\n      attr.style(\"border-radius\", \"8px\"),\n      attr.style(\"display\", \"flex\"),\n      attr.style(\"flex-direction\", \"column\"),\n      attr.style(\"gap\", \"8px\"),\n    ],\n    [\n      html.select(\n        [\n          attr.attribute(\"data-test-id\", \"drawing-select\"),\n          event.on_change(SelectDrawing),\n          attr.style(\"padding\", \"4px 8px\"),\n          attr.style(\"border-radius\", \"4px\"),\n        ],\n        list.flatten([\n          list.map(dict.to_list(model.drawings), fn(pair) {\n            let #(name, _) = pair\n            html.option(\n              [\n                attr.value(name),\n                attr.selected(name == model.active_drawing),\n              ],\n              name,\n            )\n          }),\n          [\n            html.option([attr.value(\"\")], \"+ New Drawing...\"),\n          ],\n        ]),\n      ),\n\n      // Shape Slider\n      html.input([\n        attr.type_(\"range\"),\n        attr.min(\"0\"),\n        attr.max(\"100\"),\n        attr.value(int.to_string(model.shape_slider)),\n        attr.attribute(\"data-test-id\", \"shape-slider\"),\n        event.on_input(fn(val) {\n          case int.parse(val) {\n            Ok(n) -> SetShapeSlider(n)\n            Error(_) -> SetShapeSlider(model.shape_slider)\n          }\n        }),\n      ]),\n\n      // Speed Slider\n      html.input([\n        attr.type_(\"range\"),\n        attr.min(\"-2.0\"),\n        attr.max(\"2.0\"),\n        attr.step(\"0.1\"),\n        attr.value(float.to_string(model.speed)),\n        attr.attribute(\"data-test-id\", \"speed-slider\"),\n        event.on_input(fn(val) {\n          case float.parse(val) {\n            Ok(s) -> SetSpeed(s)\n            Error(_) -> SetSpeed(model.speed)\n          }\n        }),\n      ]),\n    ],\n  )\n}\n\nfn view_reveal_code(model: Model) -> Element(Msg) {\n  case model.code_open {\n    True -> element.none()\n    False ->\n      html.button(\n        [\n          attr.class(\"icon-btn reveal-code\"),\n          attr.attribute(\"title\", \"Show code\"),\n          event.on_click(ToggleCode),\n        ],\n        [html.text(\"⟩\")],\n      )\n  }\n}\n\npub fn main() -> Nil {\n  let app = lustre.application(init, update, view)\n  let assert Ok(_) = lustre.start(app, \"#app\", Nil)\n  Nil\n}"}],"path":"src/app.gleam","source":"paste_likely"},"hash":"d2927d9acc13fcd5b3acde2ade2e714e4aa75c6e8916e3b1af818738ef80991d","kind":"doc.change","prev_hash":"abcad317bd5b9f40bfd22a4d7cff4727a4fe8c411c39b1edb38e2e868cc11331","seq":2155,"t":21742248,"wall":"2026-11-12T00:27:47.505Z"}
