{"data":{"deltas":[{"range":{"end":{"character":0,"line":349},"start":{"character":0,"line":330}},"text":"fn view_anim(model: Model) -> Element(Msg) {\n  let mouse_decoder = {\n    use x <- decode.field(\"offsetX\", decode.float)\n    use y <- decode.field(\"offsetY\", decode.float)\n    decode.success(UpdateMousePos(x, y))\n  }\n\n  html.div([attr.class(\"canvas-area\")], [\n    view_reveal_code(model),\n    view_game_stats(model),\n    view_controls(model),\n    html.canvas([\n      attr.id(\"animation-canvas\"),\n      attr.class(\"canvas\"),\n      // 🎮 确保 Canvas 能够正常拦截并捕获鼠标移动事件\n      attr.style(\"pointer-events\", \"auto\"),\n      attr.style(\"cursor\", \"crosshair\"),\n      event.on(\"mousemove\", mouse_decoder),\n    ]),\n    html.pre([attr.class(\"output\")], [html.text(model.output)]),\n  ])\n}"}],"path":"src/app.gleam","source":"paste_likely"},"hash":"0c253470dd3ed366b816a69c4561a794c04f6c078668dcc04f218f11216fe6f9","kind":"doc.change","prev_hash":"18782679540ca486d2e46f9dc81e26dc20e853832c1bf1555b74a59aeb7cb3e1","seq":1971,"t":20310640,"wall":"2026-11-12T00:03:55.869Z"}
