{"data":{"deltas":[{"range":{"end":{"character":6,"line":372},"start":{"character":4,"line":358}},"text":"// 🌟 在 Canvas 上添加与线条粗细更匹配的金色目标点 (8px x 8px)\n    html.div(\n      [\n        attr.style(\"position\", \"absolute\"),\n        // -4px 确保 div 的物理中心刚好叠加在 target_x, target_y 坐标点上\n        attr.style(\"left\", float.to_string(model.target_x -. 4.0) <> \"px\"),\n        attr.style(\"top\", float.to_string(model.target_y -. 4.0) <> \"px\"),\n        attr.style(\"width\", \"8px\"),\n        attr.style(\"height\", \"8px\"),\n        attr.style(\"background\", \"#ffd700\"),\n        attr.style(\"border-radius\", \"50%\"),\n        attr.style(\"box-shadow\", \"0 0 8px #ffd700, 0 0 14px #ffae00\"),\n        attr.style(\"pointer-events\", \"none\"),\n        attr.style(\"z-index\", \"5\"),\n      ],\n      [],\n    ),"}],"path":"src/app.gleam","source":"paste_likely"},"hash":"89ef6f201f24a756f773b51ee3e5a5c75d7577c770346e858d2134a3c688ecb6","kind":"doc.change","prev_hash":"e05a4541eaa62ea552ec83fca2e6725e1732668b61f72aa6a18a499e018a1edb","seq":2454,"t":22634819,"wall":"2026-11-12T00:42:40.078Z"}
