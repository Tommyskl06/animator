{"data":{"deltas":[{"range":{"end":{"character":1,"line":262},"start":{"character":0,"line":246}},"text":"fn view_anim(model: Model) -> Element(Msg) {\n  html.div([attr.class(\"canvas-area\")], [\n    view_reveal_code(model),\n    view_controls(model),\n    // 🎮 修改这里：在 canvas 节点上绑定 mousemove 事件\n    html.canvas([\n      attr.id(\"animation-canvas\"),\n      attr.class(\"canvas\"),\n      event.on(\"mousemove\", fn(event) {\n        // 从 DOM 事件中安全提取鼠标在 canvas 内部的 (x, y) 坐标\n        case event.offset_x, event.offset_y {\n          Ok(x), Ok(y) -> UpdateMousePos(x, y)\n          _, _ -> UpdateMousePos(model.mouse_x, model.mouse_y)\n        }\n      }),\n    ]),\n    html.pre([attr.class(\"output\")], [html.text(model.output)]),\n  ])\n}"}],"path":"src/app.gleam","source":"paste_likely"},"hash":"a3ebc9ec3991ba223b7e2f4ee07674df5834ae4fb815b6d545bd26586ecefe26","kind":"doc.change","prev_hash":"cabd930e34d6f9d3ec168dc30f6224ba2830df9eb9fc0022887d405c2c0bb63d","seq":965,"t":13281583,"wall":"2026-11-11T22:06:46.844Z"}
