{"data":{"deltas":[{"range":{"end":{"character":1,"line":595},"start":{"character":0,"line":544}},"text":"/// 🎮 辅助函数：从实际绘制的 RenderPath 列表中解析顶点，100% 锁定在青色线条上\nfn pick_target_from_paths(paths: List(render.RenderPath), seed: Int) -> #(Float, Float) {\n  let len = list.length(paths)\n  case len {\n    0 -> #(250.0, 250.0)\n    _ -> {\n      // 1. 高质散列算法全图均匀抽样\n      let index = { { seed * 1103515245 + 12345 } % 2147483647 } % len\n      let path_list = list.drop(paths, index)\n      \n      case list.first(path_list) {\n        Ok(path) -> {\n          // 在当前项目中，path.start 和 path.end 就是直接的 Float 坐标标量\n          let raw_x = path.start\n          let raw_y = path.end\n          \n          // 2. 映射回 Canvas 绝对坐标 system (250 + X, 250 - Y)\n          let canvas_x = 250.0 +. raw_x\n          let canvas_y = 250.0 -. raw_y\n          \n          #(canvas_x, canvas_y)\n        }\n        Error(_) -> #(250.0, 250.0)\n      }\n    }\n  }\n}\n\n/// 🎮 辅助函数：计算鼠标坐标到青色线条轨道的真实最小距离\nfn get_min_dist_to_paths(mx: Float, my: Float, paths: List(render.RenderPath)) -> Float {\n  let cx = mx -. 250.0\n  let cy = 250.0 -. my\n\n  case paths {\n    [] -> 0.0\n    _ -> {\n      list.fold(paths, 999999.0, fn(acc_min, path) {\n        // path.start 和 path.end 为 Float 标量\n        let dx = cx -. path.start\n        let dy = cy -. path.end\n        let dist = float.square_root(dx *. dx +. dy *. dy) |> result.unwrap(9999.0)\n        case dist <. acc_min {\n          True -> dist\n          False -> acc_min\n        }\n      })\n    }\n  }\n}"}],"path":"src/app.gleam","source":"paste_likely"},"hash":"ec0e7a1295d883c3d02cba3af8a7528fcf243bb890bd2fe504ca118b2e6d802c","kind":"doc.change","prev_hash":"a5786cf036dde8440015074e950c5476bde8988eac07e3ccb2bda1d84c90bc70","seq":2579,"t":23067208,"wall":"2026-11-12T00:49:52.469Z"}
