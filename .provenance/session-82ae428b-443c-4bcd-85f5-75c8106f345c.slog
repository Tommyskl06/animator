{"data":{"deltas":[{"range":{"end":{"character":1,"line":585},"start":{"character":0,"line":540}},"text":"/// 🎮 辅助函数：从实际渲染路径列表中根据 Seed 随机抽样挑选一个顶点的坐标\nfn pick_target_from_paths(paths: List(render.RenderPath), seed: Int) -> #(Float, Float) {\n  let len = list.length(paths)\n  case len {\n    0 -> #(250.0, 250.0)\n    _ -> {\n      let index = seed % len\n      let path_list = list.drop(paths, index)\n      case list.first(path_list) {\n        // RenderPath.start / end 为 Float 标量，坐标为相对中心 (-250 ~ 250)，需要加上 250 转回 Canvas 坐标\n        Ok(path) -> #(path.start +. 250.0, path.end +. 250.0)\n        Error(_) -> #(250.0, 250.0)\n      }\n    }\n  }\n}\n\n/// 🎮 辅助函数：计算鼠标坐标到当前所有青色线条起点/终点轨道的最小距离\nfn get_min_dist_to_paths(mx: Float, my: Float, paths: List(render.RenderPath)) -> Float {\n  let cx = mx -. 250.0\n  let cy = my -. 250.0\n\n  case paths {\n    [] -> 0.0\n    _ -> {\n      list.fold(paths, 999999.0, fn(acc_min, path) {\n        let dx = cx -. path.start\n        let dy = cy -. path.end\n        let dist = float.square_root(dx *. dx +. dy *. dy) |> result.unwrap(9999.0)\n        case dist <. acc_min {\n          True -> dist\n          False -> acc_min\n        }\n      })\n    }\n  }\n}"}],"path":"src/app.gleam","source":"paste_likely"},"hash":"f004a487582592df8f05056c158ebb422a1bf04f480905eb2a11d7201eecdc6f","kind":"doc.change","prev_hash":"796f6448efe0d0518a3b882fe9446a6f4db2dfa55f488e674a87b3c221bb9ea4","seq":2346,"t":22192783,"wall":"2026-11-12T00:35:18.041Z"}
