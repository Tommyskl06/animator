{"data":{"deltas":[{"range":{"end":{"character":1,"line":439},"start":{"character":0,"line":354}},"text":"fn view_controls(model: Model) -> Element(Msg) {\n  let status_text = case model.game_over {\n    True -> \" 💥 GAME OVER!\"\n    False -> \"\"\n  }\n\n  html.div([attr.class(\"controls\")], [\n    // 1. 游戏数据展示行\n    html.div([attr.class(\"control-group game-stats-bar\")], [\n      html.span([attr.class(\"score-label\")], [\n        html.text(\"Score: \" <> int.to_string(model.score)),\n      ]),\n      html.span([attr.class(\"health-label\"), attr.style(\"margin-left\", \"15px\"), attr.style(\"color\", \"#ff4d4d\")], [\n        html.text(\"Health: \" <> int.to_string(model.health)),\n      ]),\n      html.span([attr.style(\"margin-left\", \"10px\"), attr.style(\"color\", \"#ff6b6b\")], [\n        html.text(status_text),\n      ]),\n      html.button(\n        [\n          attr.class(\"icon-btn restart-btn\"),\n          attr.style(\"margin-left\", \"15px\"),\n          event.on_click(ResetGame),\n        ],\n        [html.text(\"Restart\")],\n      ),\n    ]),\n\n    // 2. 绘图选择下拉框 (Problem 11)\n    html.select(\n      [\n        attr.attribute(\"data-test-id\", \"drawing-select\"),\n        event.on_change(SelectDrawing),\n      ],\n      list.flatten([\n        list.map(dict.to_list(model.drawings), fn(pair) {\n          let #(name, _) = pair\n          html.option(\n            [\n              attr.value(name),\n              attr.selected(name == model.active_drawing),\n            ],\n            name,\n          )\n        }),\n        [\n          html.option([attr.value(\"\")], \"+ New Drawing...\"),\n        ],\n      ]),\n    ),\n\n    // 3. Shape Slider\n    html.input([\n      attr.type_(\"range\"),\n      attr.min(\"0\"),\n      attr.max(\"100\"),\n      attr.value(int.to_string(model.shape_slider)),\n      attr.attribute(\"data-test-id\", \"shape-slider\"),\n      event.on_input(fn(val) {\n        case int.parse(val) {\n          Ok(n) -> SetShapeSlider(n)\n          Error(_) -> SetShapeSlider(model.shape_slider)\n        }\n      }),\n    ]),\n\n    // 4. Speed Slider\n    html.input([\n      attr.type_(\"range\"),\n      attr.min(\"-2.0\"),\n      attr.max(\"2.0\"),\n      attr.step(\"0.1\"),\n      attr.value(float.to_string(model.speed)),\n      attr.attribute(\"data-test-id\", \"speed-slider\"),\n      event.on_input(fn(val) {\n        case float.parse(val) {\n          Ok(s) -> SetSpeed(s)\n          Error(_) -> SetSpeed(model.speed)\n        }\n      }),\n    ]),\n  ])\n}"}],"path":"src/app.gleam","source":"paste_likely"},"hash":"4c4c3317ed910306e9b0a65e234080a5c1bfeb39750b54f52ededc705f9833b8","kind":"doc.change","prev_hash":"c89a7f727f4ff72d72bbc2806918f9cc44887c6eaf61fa83a028323a4557c20a","seq":1847,"t":19841891,"wall":"2026-11-11T23:56:07.125Z"}
