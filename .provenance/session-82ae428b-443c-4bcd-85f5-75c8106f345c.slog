{"data":{"deltas":[{"range":{"end":{"character":1,"line":565},"start":{"character":0,"line":544}},"text":"/// 🎮 辅助函数：利用 8 方向向量分发算法，生成遍布全图且绝对不卡死的目标点\nfn pick_target_from_paths(_paths: List(render.RenderPath), seed: Int) -> #(Float, Float) {\n  // 1. 生成 0 ~ 7 的均匀方向索引 (避免负数取模问题)\n  let raw_step = { seed * 1664525 + 1013904223 } % 8\n  let step = case raw_step < 0 {\n    True -> 0 - raw_step\n    False -> raw_step\n  }\n\n  // 2. 动态生成扩散半径 (60px ~ 160px)，确保覆盖全图骨架\n  let raw_rad = { seed * 37 } % 100\n  let abs_rad = case raw_rad < 0 {\n    True -> 0 - raw_rad\n    False -> raw_rad\n  }\n  let radius = 60.0 +. int.to_float(abs_rad)\n\n  // 3. 使用标准 8 方向单位向量 (cos, sin 精确值)，无需导入任何外部数学库\n  let #(dir_x, dir_y) = case step {\n    0 -> #(1.0, 0.0)       // 正右\n    1 -> #(0.707, -0.707)  // 右上\n    2 -> #(0.0, -1.0)      // 正上\n    3 -> #(-0.707, -0.707) // 左上\n    4 -> #(-1.0, 0.0)      // 正左\n    5 -> #(-0.707, 0.707)  // 左下\n    6 -> #(0.0, 1.0)       // 正下\n    _ -> #(0.707, 0.707)   // 右下\n  }\n\n  // 4. 计算 Canvas 绝对坐标并加上边界保护\n  let raw_x = 250.0 +. radius *. dir_x\n  let raw_y = 250.0 +. radius *. dir_y\n\n  let clamped_x = float.max(60.0, float.min(440.0, raw_x))\n  let clamped_y = float.max(60.0, float.min(440.0, raw_y))\n\n  #(clamped_x, clamped_y)\n}"}],"path":"src/app.gleam","source":"paste_likely"},"hash":"9fee175ad526d5a164ac04f57f054a82dc648632e0ebdaac06904a20ce1eccc1","kind":"doc.change","prev_hash":"e9f9d2de686dda6cda40c8c8e7eff72c3528eb5576c80dce5b915ce94a71a11d","seq":2877,"t":31392001,"wall":"2026-11-12T03:08:37.220Z"}
