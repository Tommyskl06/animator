{"data":{"deltas":[{"range":{"end":{"character":5,"line":310},"start":{"character":0,"line":232}},"text":"// 🎮 鼠标移动：基于线段顶点的精确目标收集与碰撞\n    UpdateMousePos(x, y) -> {\n      case model.game_over {\n        True -> #(model, effect.none())\n        False -> {\n          let current_cd = case model.cooldown_ticks > 0 {\n            True -> model.cooldown_ticks - 1\n            False -> 0\n          }\n\n          // 1. 判定是否触碰到黄色目标点 (碰撞容容错范围扩大至 35px，确保触碰即判定)\n          let dx = x -. model.target_x\n          let dy = y -. model.target_y\n          let hit_target = { dx *. dx +. dy *. dy } <=. 1225.0\n\n          let #(new_score, next_tx, next_ty, msg_collected) = case hit_target {\n            True -> {\n              let ns = model.score + 50\n              // 选取下一个精准贴在青色线条端点上的坐标\n              let #(tx, ty) = pick_target_from_paths(model.current_paths, ns)\n              #(ns, tx, ty, \"✨ TARGET COLLECTED! (+50)\")\n            }\n            False -> #(model.score, model.target_x, model.target_y, model.status_msg)\n          }\n\n          // 2. 检查偏离轨道判定 (鼠标距离图形中心区域过远且超出防护边界时扣血)\n          let dist_from_center = {\n            let cx = x -. 250.0\n            let cy = y -. 250.0\n            cx *. cx +. cy *. cy\n          }\n\n          // 处于 Canvas 外围危险区 (距离中心 > 220px) 且非冷却期\n          let is_off_track = dist_from_center >. 48400.0 && x >. 10.0 && x <. 490.0 && y >. 10.0 && y <. 490.0\n\n          let #(final_health, final_cd, final_msg, is_dead) = case is_off_track && current_cd == 0 {\n            True -> {\n              let nh = model.health - 1\n              case nh <= 0 {\n                True -> #(0, 0, \"💥 GAME OVER!\", True)\n                False -> #(nh, 30, \"⚠️ OFF TRACK! (-1 HP)\", False)\n              }\n            }\n            False -> #(model.health, current_cd, msg_collected, model.health <= 0)\n          }\n\n          #(\n            Model(\n              ..model,\n              mouse_x: x,\n              mouse_y: y,\n              score: new_score,\n              health: final_health,\n              game_over: is_dead,\n              cooldown_ticks: final_cd,\n              status_msg: final_msg,\n              target_x: next_tx,\n              target_y: next_ty,\n            ),\n            effect.none(),\n          )\n        }\n      }\n    }"}],"path":"src/app.gleam","source":"paste_likely"},"hash":"f15cbc4fff6e53bb2dd69c4f97cac93e74b5f1906d2caf34e8a475ec809aa01a","kind":"doc.change","prev_hash":"897eb5ffe76d7e0dfdaddeb1241d479a77917446db8352ccf440c1316d4153c1","seq":2386,"t":22563348,"wall":"2026-11-12T00:41:28.608Z"}
