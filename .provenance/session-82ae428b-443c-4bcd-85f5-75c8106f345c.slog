{"data":{"deltas":[{"range":{"end":{"character":1,"line":298},"start":{"character":0,"line":273}},"text":"fn process_collisions(\n  mx: Float,\n  my: Float,\n  _paths: List(render.RenderPath),\n  current_score: Int,\n  current_health: Int,\n) -> #(Int, Int, Bool) {\n  // Canvas 尺寸通常为 500x500，计算鼠标相对于画布中心的偏移\n  let cx = mx -. 250.0\n  let cy = my -. 250.0\n  let dist_sq = cx *. cx +. cy *. cy\n\n  // 当鼠标滑入青色图形所在区域（半径 180px 范围），且坐标在有效范围内时触发计分\n  // 32400.0 = 180 * 180\n  let collided = dist_sq <=. 32400.0 && mx >. 0.0 && my >. 0.0\n\n  case collided {\n    True -> {\n      // 每次触碰图形有效区域增加 1 分\n      let score = current_score + 1\n      #(score, current_health, current_health <= 0)\n    }\n    False -> #(current_score, current_health, current_health <= 0)\n  }"}],"path":"src/app.gleam","source":"paste_likely"},"hash":"693d856de42248df341c77054737071c8bf3ad786492fbf888b05a87daeaca9e","kind":"doc.change","prev_hash":"b78663ab796a3658d26c20282dadf715b0dd4d7002e7bd020b5e2fce79d1ed4f","seq":2007,"t":20350714,"wall":"2026-11-12T00:04:35.943Z"}
