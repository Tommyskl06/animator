{"data":{"deltas":[{"range":{"end":{"character":1,"line":271},"start":{"character":0,"line":247}},"text":"fn view_anim(model: Model) -> Element(Msg) {\n  // 构建解析 event.offsetX 和 event.offsetY 的 Decoder\n  let mouse_decoder = {\n    use x <- decode.field(\"offsetX\", decode.float)\n    use y <- decode.field(\"offsetY\", decode.float)\n    decode.success(UpdateMousePos(x, y))\n  }\n\n  html.div([attr.class(\"canvas-area\")], [\n    view_reveal_code(model),\n    view_controls(model),\n    html.canvas([\n      attr.id(\"animation-canvas\"),\n      attr.class(\"canvas\"),\n      // 🎮 使用构造好的 mouse_decoder，满足 Decoder(Msg) 类型要求\n      event.on(\"mousemove\", mouse_decoder),\n    ]),\n    html.pre([attr.class(\"output\")], [html.text(model.output)]),\n  ])\n}"}],"path":"src/app.gleam","source":"paste_likely"},"hash":"d01d5b60b5db34480b573d711d20cb13ac8e679afc7454df7f2e4501ee80d933","kind":"doc.change","prev_hash":"06771dc9e295f5bb301b152964fd445e6657e93a7b1610d7c8626d8b2a744409","seq":1169,"t":13545155,"wall":"2026-11-11T22:11:10.416Z"}
