{"data":{"deltas":[{"range":{"end":{"character":1,"line":99},"start":{"character":0,"line":71}},"text":"pub fn init(_flags: Nil) -> #(Model, Effect(Msg)) {\n  let lib: data.Library = data.load_library()\n  let current_source = case dict.get(lib.drawings, lib.active) {\n    Ok(code) -> code\n    Error(_) -> default_code\n  }\n\n  let #(_, initial_paths) = evaluate_and_render(10, current_source)\n\n  #(\n    Model(\n      source: current_source,\n      code_open: True,\n      output: \"\",\n      shape_slider: 10,\n      speed: 1.0,\n      active_drawing: lib.active,\n      drawings: lib.drawings,\n      mouse_x: 0.0,\n      mouse_y: 0.0,\n      score: 0,\n      health: 3,\n      game_over: False,\n      current_paths: initial_paths,\n    ),\n    effect.batch([\n      editor.mount(current_source, SetCode),\n      effect.from(fn(dispatch) { dispatch(SetCode(current_source)) }),\n    ]),\n  )\n}"}],"path":"src/app.gleam","source":"paste_likely"},"hash":"65b19acbdb93015fb45c565d4bcffed5406df7e8e5916eb921c3511850eb7f03","kind":"doc.change","prev_hash":"9d08b6217d5ae85e7daf1fd8907eb82c4b30c898fdaa345924ef6d4e0a8a03ef","seq":2049,"t":20408138,"wall":"2026-11-12T00:05:33.367Z"}
