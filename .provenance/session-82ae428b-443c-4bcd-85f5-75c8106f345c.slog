{"data":{"deltas":[{"range":{"end":{"character":1,"line":337},"start":{"character":0,"line":266}},"text":"fn view_controls(model: Model) -> Element(Msg) {\n  html.div([attr.class(\"controls\")], [\n    html.div([attr.class(\"game-stats\")], [\n      html.span([attr.style(\"font-weight\", \"bold\")], [\n        html.text(\"Score: \" <> int.to_string(model.score)),\n      ]),\n      html.span([attr.style(\"margin-left\", \"10px\"), attr.style(\"color\", \"red\")], [\n        html.text(\" | Health: \" <> int.to_string(model.health)),\n      ]),\n      html.button(\n        [\n          attr.class(\"icon-btn\"),\n          attr.style(\"margin-left\", \"10px\"),\n          event.on_click(ResetGame),\n        ],\n        [html.text(\"Restart\")],\n      ),\n    ]),\n\n    html.select(\n      [\n        attr.attribute(\"data-test-id\", \"drawing-select\"),\n        event.on_change(SelectDrawing),\n      ],\n      list.flatten([\n        list.map(dict.to_list(model.drawings), fn(pair) {\n          let #(name, _) = pair\n          html.option(\n            [\n              attr.value(name),\n              attr.selected(name == model.active_drawing),\n            ],\n            name,\n          )\n        }),\n        [\n          html.option([attr.value(\"\")], \"+ New Drawing...\"),\n        ],\n      ]),\n    ),\n\n    // Shape Slider\n    html.input([\n      attr.type_(\"range\"),\n      attr.min(\"0\"),\n      attr.max(\"100\"),\n      attr.value(int.to_string(model.shape_slider)),\n      attr.attribute(\"data-test-id\", \"shape-slider\"),\n      event.on_input(fn(val) {\n        case int.parse(val) {\n          Ok(n) -> SetShapeSlider(n)\n          Error(_) -> SetShapeSlider(model.shape_slider)\n        }\n      }),\n    ]),\n\n    // Speed Slider\n    html.input([\n      attr.type_(\"range\"),\n      attr.min(\"-2.0\"),\n      attr.max(\"2.0\"),\n      attr.step(\"0.1\"),\n      attr.value(float.to_string(model.speed)),\n      attr.attribute(\"data-test-id\", \"speed-slider\"),\n      event.on_input(fn(val) {\n        case float.parse(val) {\n          Ok(s) -> SetSpeed(s)\n          Error(_) -> SetSpeed(model.speed)\n        }\n      }),\n    ]),\n  ])\n}"}],"path":"src/app.gleam","source":"paste_likely"},"hash":"9f8d1ec6d25df70c5d738c2fdc5733093718ef6e4cf5bb3f868c62eef97a2661","kind":"doc.change","prev_hash":"9810446d7ccbe4f00c3908ab803d27dd29e187803438df30fbe2c831bcd1d23a","seq":1330,"t":13645892,"wall":"2026-11-11T22:12:51.152Z"}
