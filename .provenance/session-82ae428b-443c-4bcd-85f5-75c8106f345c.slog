{"data":{"deltas":[{"range":{"end":{"character":1,"line":570},"start":{"character":0,"line":544}},"text":"/// 🎮 辅助函数：利用散列算法在整个 RenderPath 列表的节点中全图随机抽样\nfn pick_target_from_paths(paths: List(render.RenderPath), seed: Int) -> #(Float, Float) {\n  let len = list.length(paths)\n  case len {\n    0 -> #(250.0, 250.0)\n    _ -> {\n      // 1. 使用质数乘积散列，确保 index 在 0 ~ (len - 1) 之间均匀全图随机映射\n      let hashed_index = { { seed * 2654435761 } % 2147483647 } % len\n      let path_list = list.drop(paths, hashed_index)\n      \n      case list.first(path_list) {\n        Ok(path) -> {\n          // 2. 奇偶数交替选取线段的 start 端点或 end 端点，使刷新点遍布全图末梢与拐角\n          let is_even = { seed % 2 } == 0\n          let raw_offset = case is_even {\n            True -> path.start\n            False -> path.end\n          }\n          \n          // 3. 映射回 Canvas 绝对坐标 (250 + offset) 并约束在有效画布内\n          let raw_x = 250.0 +. raw_offset\n          let raw_y = 250.0 +. { raw_offset *. 0.75 } // 兼顾上下左右分布\n          \n          let clamped_x = float.max(50.0, float.min(450.0, raw_x))\n          let clamped_y = float.max(50.0, float.min(450.0, raw_y))\n          #(clamped_x, clamped_y)\n        }\n        Error(_) -> #(250.0, 250.0)\n      }\n    }\n  }\n}"}],"path":"src/app.gleam","source":"paste_likely"},"hash":"84dcb93b62287c3e1d44fb350d413b2691d33cd29afaab268dfa8f60d3a7a8b7","kind":"doc.change","prev_hash":"c27fa662f8ec5706be3ab3432ca3fbfd9a250a80bbbc3c88b67b4637459c9c2e","seq":2483,"t":22808349,"wall":"2026-11-12T00:45:33.609Z"}
