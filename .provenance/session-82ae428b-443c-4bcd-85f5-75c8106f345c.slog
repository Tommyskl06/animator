{"data":{"content":"/// 🎮 辅助函数：从实际渲染路径列表中根据 Seed 随机抽样挑选一个顶点的坐标\nfn pick_target_from_paths(paths: List(render.RenderPath), seed: Int) -> #(Float, Float) {\n  let len = list.length(paths)\n  case len {\n    0 -> #(250.0, 250.0)\n    _ -> {\n      let index = seed % len\n      let path_list = list.drop(paths, index)\n      case list.first(path_list) {\n        // RenderPath 的 start_x, start_y 是相对坐标 (-250 ~ 250)，需要加上 250 转回 Canvas 绝对坐标\n        Ok(path) -> #(path.start_x +. 250.0, path.start_y +. 250.0)\n        Error(_) -> #(250.0, 250.0)\n      }\n    }\n  }\n}\n\n/// 🎮 辅助函数：计算鼠标坐标到当前所有青色线条的最大/最小离线距离\nfn get_min_dist_to_paths(mx: Float, my: Float, paths: List(render.RenderPath)) -> Float {\n  // 转为相对中心坐标\n  let cx = mx -. 250.0\n  let cy = my -. 250.0\n\n  case paths {\n    [] -> 0.0\n    _ -> {\n      list.fold(paths, 999999.0, fn(acc_min, path) {\n        // 计算点到线段起点的简单平移距离\n        let dx = cx -. path.start_x\n        let dy = cy -. path.start_y\n        let dist = float.square_root(dx *. dx +. dy *. dy) |> result.unwrap(9999.0)\n        case dist <. acc_min {\n          True -> dist\n          False -> acc_min\n        }\n      })\n    }\n  }\n}","length":1311,"path":"src/app.gleam","range":{"end":{"character":0,"line":540},"start":{"character":0,"line":540}},"sha256":"59675453790594b1404b36d88dc0d12462961c3ef9999854b36bfbaaa8078ab1"},"hash":"cf7eaa7caa28c82697b6fe949242a52ff971ceafa30dc910cfebdcc85c361e60","kind":"paste","prev_hash":"2f02555743ccd7497d79ccd11ae1a0c2e54520d726b20cb74b56deb0ed70b06a","seq":2208,"t":21973808,"wall":"2026-11-12T00:31:39.065Z"}
