{"data":{"deltas":[{"range":{"end":{"character":1,"line":314},"start":{"character":0,"line":246}},"text":"fn view_anim(model: Model) -> Element(Msg) {\n  html.div([attr.class(\"canvas-area\")], [\n    view_reveal_code(model),\n    view_controls(model),\n    html.canvas([\n      attr.id(\"animation-canvas\"),\n      attr.class(\"canvas\"),\n      // 🎮 1. 监听 Canvas 上的鼠标移动事件，解构出 offset_x 和 offset_y\n      event.on(\"mousemove\", fn(event) {\n        case event.offset_x, event.offset_y {\n          Ok(x), Ok(y) -> UpdateMousePos(x, y)\n          _, _ -> UpdateMousePos(model.mouse_x, model.mouse_y)\n        }\n      }),\n    ]),\n    html.pre([attr.class(\"output\")], [html.text(model.output)]),\n  ])\n}\n\nfn view_controls(model: Model) -> Element(Msg) {\n  html.div([attr.class(\"controls\")], [\n    // 🎮 2. 新增：游戏计分面板与重置按钮\n    html.div([attr.class(\"game-stats\")], [\n      html.span([attr.style([#(\"font-weight\", \"bold\")])], [\n        html.text(\"Score: \" <> int.to_string(model.score)),\n      ]),\n      html.span([attr.style([#(\"margin-left\", \"10px\"), #(\"color\", \"red\")])], [\n        html.text(\"Health: \" <> int.to_string(model.health)),\n      ]),\n      html.button(\n        [\n          attr.class(\"icon-btn\"),\n          attr.style([#(\"margin-left\", \"10px\")]),\n          event.on_click(ResetGame),\n        ],\n        [html.text(\"Restart\")],\n      ),\n    ]),\n\n    // 原有的 Drawing 下拉选择菜单\n    html.select(\n      [\n        attr.attribute(\"data-test-id\", \"drawing-select\"),\n        event.on_change(SelectDrawing),\n      ],\n      list.flatten([\n        list.map(dict.to_list(model.drawings), fn(pair) {\n          let #(name, _) = pair\n          html.option(\n            [\n              attr.value(name),\n              attr.selected(name == model.active_drawing),\n            ],\n            name,\n          )\n        }),\n        [\n          html.option([attr.value(\"\")], \"+ New Drawing...\"),\n        ],\n      ]),\n    ),\n\n    // Shape Slider\n    html.input([\n      attr.type_(\"range\"),\n      attr.min(\"0\"),\n      attr.max(\"100\"),\n      attr.value(int.to_string(model.shape_slider)),\n      attr.attribute(\"data-test-id\", \"shape-slider\"),\n      event.on_input(fn(val) {\n        case int.parse(val) {\n          Ok(n) -> SetShapeSlider(n)\n          Error(_) -> SetShapeSlider(model.shape_slider)\n        }\n      }),\n    ]),\n\n    // Speed Slider\n    html.input([\n      attr.type_(\"range\"),\n      attr.min(\"-2.0\"),\n      attr.max(\"2.0\"),\n      attr.step(\"0.1\"),\n      attr.value(float.to_string(model.speed)),\n      attr.attribute(\"data-test-id\", \"speed-slider\"),\n      event.on_input(fn(val) {\n        case float.parse(val) {\n          Ok(s) -> SetSpeed(s)\n          Error(_) -> SetSpeed(model.speed)\n        }\n      }),\n    ]),\n  ])\n}"}],"path":"src/app.gleam","source":"paste_likely"},"hash":"40c6b67820f64ce42d83086dfc1733006e658c64a4bebb8121deec676638cb50","kind":"doc.change","prev_hash":"bed6337c279a37f20595b2973ffe96b2d22a0a340d955a3ae2d552b0144e6436","seq":863,"t":13175139,"wall":"2026-11-11T22:05:00.400Z"}
