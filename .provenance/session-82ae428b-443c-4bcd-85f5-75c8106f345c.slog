{"data":{"deltas":[{"range":{"end":{"character":1,"line":605},"start":{"character":0,"line":544}},"text":"/// 🎮 辅助函数：从实际绘制的 RenderPath 列表中解析真实 Point(x, y) 顶点，百分百锁定在青色线条上\nfn pick_target_from_paths(paths: List(render.RenderPath), seed: Int) -> #(Float, Float) {\n  let len = list.length(paths)\n  case len {\n    0 -> #(250.0, 250.0)\n    _ -> {\n      // 1. 使用高质散列算法，确保选取索引均匀遍布 List 中所有的 RenderPath\n      let index = { { seed * 1103515245 + 12345 } % 2147483647 } % len\n      let path_list = list.drop(paths, index)\n      \n      case list.first(path_list) {\n        Ok(path) -> {\n          // 2. 根据 seed 奇偶，交替选取该线段的 start 点或 end 点\n          let is_even = { seed % 2 } == 0\n          let target_pt = case is_even {\n            True -> path.start\n            False -> path.end\n          }\n          \n          // 3. 使用标准 Canvas 笛卡尔坐标转换，100% 映射到线条实际位置\n          let canvas_x = 250.0 +. target_pt.x\n          let canvas_y = 250.0 -. target_pt.y\n          \n          #(canvas_x, canvas_y)\n        }\n        Error(_) -> #(250.0, 250.0)\n      }\n    }\n  }\n}\n\n/// 🎮 辅助函数：计算鼠标坐标 (mx, my) 到青色线条顶点真实的最小距离\nfn get_min_dist_to_paths(mx: Float, my: Float, paths: List(render.RenderPath)) -> Float {\n  // 转换为相对原点坐标\n  let cx = mx -. 250.0\n  let cy = 250.0 -. my\n\n  case paths {\n    [] -> 0.0\n    _ -> {\n      list.fold(paths, 999999.0, fn(acc_min, path) {\n        let dx = cx -. path.start.x\n        let dy = cy -. path.start.y\n        let dist = float.square_root(dx *. dx +. dy *. dy) |> result.unwrap(9999.0)\n        case dist <. acc_min {\n          True -> dist\n          False -> acc_min\n        }\n      })\n    }\n  }\n}"}],"path":"src/app.gleam","source":"paste_likely"},"hash":"29c79035033e46be795096a0de5e8db23a0af3eba0fa306e5b7cb5a630446261","kind":"doc.change","prev_hash":"da8559843d54076ac52ecaa3e237072dd28acf761fc2816fa8bba5878ac86841","seq":2531,"t":22952277,"wall":"2026-11-12T00:47:57.537Z"}
