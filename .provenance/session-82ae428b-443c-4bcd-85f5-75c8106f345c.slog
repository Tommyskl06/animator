{"data":{"deltas":[{"range":{"end":{"character":0,"line":454},"start":{"character":0,"line":0}},"text":"//// Animator -- an application for program-generated drawings.\n\nimport builtins\nimport data\nimport drawing\nimport editor\nimport errors\nimport gleam/dict.{type Dict}\nimport gleam/dynamic/decode\nimport gleam/float\nimport gleam/int\nimport gleam/list\nimport gleam/result\nimport gleam/string\nimport lustre\nimport lustre/attribute as attr\nimport lustre/effect.{type Effect}\nimport lustre/element.{type Element}\nimport lustre/element/html\nimport lustre/event\nimport parser\nimport render\nimport shape.{type Path}\n\npub const public_url = \"https://github.com/Tommyskl06/animator\"\npub const include_app_in_gallery = True\npub const video_url = \"\"\npub const include_video_in_gallery = False\n\nconst default_code =\n  \"fn draw(shape_slider: Int) -> List(Path) {\\n  [Path(Line(Point(0, 0), Point(100, 100)), 0, 10, 2)]\\n}\\n\"\n\n// ── Model ──────────────────────────────────────────────────────────────────────\n\npub type Model {\n  Model(\n    source: String,\n    code_open: Bool,\n    output: String,\n    shape_slider: Int,\n    speed: Float,\n    active_drawing: String,\n    drawings: Dict(String, String),\n    // 🎮 Extension State\n    mouse_x: Float,\n    mouse_y: Float,\n    score: Int,\n    health: Int,\n    game_over: Bool,\n    // Stores current rendered paths for real-time collision checks\n    current_paths: List(render.RenderPath),\n  )\n}\n\npub type Msg {\n  SetCode(String)\n  ToggleCode\n  SetShapeSlider(Int)\n  SetSpeed(Float)\n  SelectDrawing(String)\n  CreateDrawing\n  // 🎮 Extension Messages\n  UpdateMousePos(Float, Float)\n  ResetGame\n}\n\n// ── Init ───────────────────────────────────────────────────────────────────────\n\npub fn init(_flags: Nil) -> #(Model, Effect(Msg)) {\n  let lib: data.Library = data.load_library()\n  let current_source = case dict.get(lib.drawings, lib.active) {\n    Ok(code) -> code\n    Error(_) -> default_code\n  }\n\n  #(\n    Model(\n      source: current_source,\n      code_open: True,\n      output: \"\",\n      shape_slider: 10,\n      speed: 1.0,\n      active_drawing: lib.active,\n      drawings: lib.drawings,\n      mouse_x: 0.0,\n      mouse_y: 0.0,\n      score: 0,\n      health: 3,\n      game_over: False,\n      current_paths: [],\n    ),\n    effect.batch([\n      editor.mount(current_source, SetCode),\n      effect.from(fn(dispatch) { dispatch(SetCode(current_source)) }),\n    ]),\n  )\n}\n\nfn run_source(shape_slider: Int, source: String) -> Result(List(Path), String) {\n  case parser.parse_program(source, builtins.global_frame()) {\n    Error(msg) -> Error(msg)\n    Ok(program) ->\n      drawing.try_draw(shape_slider, program)\n      |> result.map_error(errors.error_message)\n  }\n}\n\n// ── Update ─────────────────────────────────────────────────────────────────────\n\npub fn update(model: Model, msg: Msg) -> #(Model, Effect(Msg)) {\n  case msg {\n    ToggleCode -> #(Model(..model, code_open: !model.code_open), effect.none())\n\n    SetCode(text) -> {\n      let #(output_text, render_paths) =\n        evaluate_and_render(model.shape_slider, text)\n      render.set_drawing(render_paths)\n\n      let updated_drawings =\n        dict.insert(model.drawings, model.active_drawing, text)\n      let new_model =\n        Model(\n          ..model,\n          source: text,\n          output: output_text,\n          drawings: updated_drawings,\n          current_paths: render_paths,\n        )\n\n      data.save_library(data.Library(\n        active: new_model.active_drawing,\n        drawings: updated_drawings,\n      ))\n\n      #(new_model, effect.none())\n    }\n\n    SetShapeSlider(val) -> {\n      let #(output_text, render_paths) = evaluate_and_render(val, model.source)\n      render.set_drawing(render_paths)\n\n      // Evaluate collisions on timeline slider updates\n      let #(new_score, new_health, is_dead) =\n        process_collisions(\n          model.mouse_x,\n          model.mouse_y,\n          render_paths,\n          model.score,\n          model.health,\n        )\n\n      #(\n        Model(\n          ..model,\n          output: output_text,\n          shape_slider: val,\n          current_paths: render_paths,\n          score: new_score,\n          health: new_health,\n          game_over: is_dead,\n        ),\n        effect.none(),\n      )\n    }\n\n    SetSpeed(spd) -> {\n      render.set_speed(spd)\n      #(Model(..model, speed: spd), effect.none())\n    }\n\n    SelectDrawing(name) -> {\n      case name {\n        \"\" -> update(model, CreateDrawing)\n        _ -> {\n          case dict.get(model.drawings, name) {\n            Ok(code) -> {\n              let #(output_text, render_paths) =\n                evaluate_and_render(model.shape_slider, code)\n              render.set_drawing(render_paths)\n\n              let new_model =\n                Model(\n                  ..model,\n                  active_drawing: name,\n                  source: code,\n                  output: output_text,\n                  current_paths: render_paths,\n                )\n              data.save_library(data.Library(\n                active: name,\n                drawings: model.drawings,\n              ))\n\n              #(new_model, editor.mount(code, SetCode))\n            }\n            Error(_) -> #(model, effect.none())\n          }\n        }\n      }\n    }\n\n    CreateDrawing -> {\n      let new_name = data.prompt_drawing_name()\n      case new_name {\n        \"\" -> #(model, effect.none())\n        _ -> {\n          let updated_drawings =\n            dict.insert(model.drawings, new_name, default_code)\n          let #(output_text, render_paths) =\n            evaluate_and_render(model.shape_slider, default_code)\n          render.set_drawing(render_paths)\n\n          let new_model =\n            Model(\n              ..model,\n              active_drawing: new_name,\n              source: default_code,\n              output: output_text,\n              drawings: updated_drawings,\n              current_paths: render_paths,\n            )\n          data.save_library(data.Library(\n            active: new_name,\n            drawings: updated_drawings,\n          ))\n\n          #(new_model, editor.mount(default_code, SetCode))\n        }\n      }\n    }\n\n    // 🎮 Handle mouse movements and evaluate interactive collisions\n    UpdateMousePos(x, y) -> {\n      case model.game_over {\n        True -> #(model, effect.none())\n        False -> {\n          let #(new_score, new_health, is_dead) =\n            process_collisions(\n              x,\n              y,\n              model.current_paths,\n              model.score,\n              model.health,\n            )\n\n          #(\n            Model(\n              ..model,\n              mouse_x: x,\n              mouse_y: y,\n              score: new_score,\n              health: new_health,\n              game_over: is_dead,\n            ),\n            effect.none(),\n          )\n        }\n      }\n    }\n\n    // 🎮 Reset game stats and status\n    ResetGame -> {\n      #(\n        Model(\n          ..model,\n          score: 0,\n          health: 3,\n          game_over: False,\n        ),\n        effect.none(),\n      )\n    }\n  }\n}\n\n// ── 🎮 Extension Game & Collision Engine ──────────────────────────────────────\n\n/// Calculates collision status between mouse avatar and active render paths\nfn process_collisions(\n  mx: Float,\n  my: Float,\n  paths: List(render.RenderPath),\n  current_score: Int,\n  current_health: Int,\n) -> #(Int, Int, Bool) {\n  // Map absolute Canvas coordinates (0~500) to relative center (0,0)\n  let cx = mx -. 250.0\n  let cy = my -. 250.0\n\n  // Check if mouse position is within hit radius (35 pixels)\n  let collided =\n    list.any(paths, fn(_p) {\n      let dist_sq = cx *. cx +. cy *. cy\n      dist_sq <=. 1225.0\n    })\n\n  case collided {\n    True -> {\n      let score = current_score + 1\n      #(score, current_health, current_health <= 0)\n    }\n    False -> #(current_score, current_health, current_health <= 0)\n  }\n}\n\nfn evaluate_and_render(\n  shape_slider: Int,\n  source: String,\n) -> #(String, List(render.RenderPath)) {\n  case run_source(shape_slider, source) {\n    Ok(paths) -> {\n      let r_paths = list.map(paths, fn(p) { render.render_path(p, \"black\") })\n      #(string.inspect(paths), r_paths)\n    }\n    Error(msg) -> #(msg, [])\n  }\n}\n\n// ── View ──────────────────────────────────────────────────────────────────\n\npub fn view(model: Model) -> Element(Msg) {\n  let app_class = case model.code_open {\n    True -> \"app\"\n    False -> \"app code-hidden\"\n  }\n\n  html.div([attr.class(app_class)], [\n    html.div([attr.class(\"code-col\")], [\n      editor.view_panel(ToggleCode),\n    ]),\n    view_anim(model),\n  ])\n}\n\nfn view_anim(model: Model) -> Element(Msg) {\n  // Dynamic decoder to extract offsetX and offsetY from mousemove event\n  let mouse_decoder = {\n    use x <- decode.field(\"offsetX\", decode.float)\n    use y <- decode.field(\"offsetY\", decode.float)\n    decode.success(UpdateMousePos(x, y))\n  }\n\n  html.div([attr.class(\"canvas-area\")], [\n    view_reveal_code(model),\n    view_controls(model),\n    html.canvas([\n      attr.id(\"animation-canvas\"),\n      attr.class(\"canvas\"),\n      event.on(\"mousemove\", mouse_decoder),\n    ]),\n    html.pre([attr.class(\"output\")], [html.text(model.output)]),\n  ])\n}\n\nfn view_controls(model: Model) -> Element(Msg) {\n  let status_text = case model.game_over {\n    True -> \" 💥 GAME OVER!\"\n    False -> \"\"\n  }\n\n  html.div([attr.class(\"controls\")], [\n    // 🎮 Game Statistics Panel\n    html.div([attr.class(\"game-stats\")], [\n      html.span([attr.style(\"font-weight\", \"bold\")], [\n        html.text(\"Score: \" <> int.to_string(model.score)),\n      ]),\n      html.span(\n        [attr.style(\"margin-left\", \"10px\"), attr.style(\"color\", \"red\")],\n        [\n          html.text(\" | Health: \" <> int.to_string(model.health)),\n        ],\n      ),\n      html.span(\n        [attr.style(\"margin-left\", \"10px\"), attr.style(\"color\", \"darkred\"), attr.style(\"font-weight\", \"bold\")],\n        [html.text(status_text)],\n      ),\n      html.button(\n        [\n          attr.class(\"icon-btn\"),\n          attr.style(\"margin-left\", \"10px\"),\n          event.on_click(ResetGame),\n        ],\n        [html.text(\"Restart\")],\n      ),\n    ]),\n\n    html.select(\n      [\n        attr.attribute(\"data-test-id\", \"drawing-select\"),\n        event.on_change(SelectDrawing),\n      ],\n      list.flatten([\n        list.map(dict.to_list(model.drawings), fn(pair) {\n          let #(name, _) = pair\n          html.option(\n            [\n              attr.value(name),\n              attr.selected(name == model.active_drawing),\n            ],\n            name,\n          )\n        }),\n        [\n          html.option([attr.value(\"\")], \"+ New Drawing...\"),\n        ],\n      ]),\n    ),\n\n    // Shape Slider\n    html.input([\n      attr.type_(\"range\"),\n      attr.min(\"0\"),\n      attr.max(\"100\"),\n      attr.value(int.to_string(model.shape_slider)),\n      attr.attribute(\"data-test-id\", \"shape-slider\"),\n      event.on_input(fn(val) {\n        case int.parse(val) {\n          Ok(n) -> SetShapeSlider(n)\n          Error(_) -> SetShapeSlider(model.shape_slider)\n        }\n      }),\n    ]),\n\n    // Speed Slider\n    html.input([\n      attr.type_(\"range\"),\n      attr.min(\"-2.0\"),\n      attr.max(\"2.0\"),\n      attr.step(\"0.1\"),\n      attr.value(float.to_string(model.speed)),\n      attr.attribute(\"data-test-id\", \"speed-slider\"),\n      event.on_input(fn(val) {\n        case float.parse(val) {\n          Ok(s) -> SetSpeed(s)\n          Error(_) -> SetSpeed(model.speed)\n        }\n      }),\n    ]),\n  ])\n}\n\nfn view_reveal_code(model: Model) -> Element(Msg) {\n  case model.code_open {\n    True -> element.none()\n    False ->\n      html.button(\n        [\n          attr.class(\"icon-btn reveal-code\"),\n          attr.attribute(\"title\", \"Show code\"),\n          event.on_click(ToggleCode),\n        ],\n        [html.text(\"⟩\")],\n      )\n  }\n}\n\npub fn main() -> Nil {\n  let app = lustre.application(init, update, view)\n  let assert Ok(_) = lustre.start(app, \"#app\", Nil)\n  Nil\n}"}],"path":"src/app.gleam","source":"paste_likely"},"hash":"13df52e5c298df8ac89e1a336e5da749fd31f54b18f9ac9efce257f87d61e96c","kind":"doc.change","prev_hash":"713ad597d2065fe5b0a1d224f3b18009d00bc1fedc8d7d74f4e2f96e1102a349","seq":1535,"t":14168839,"wall":"2026-11-11T22:21:34.099Z"}
