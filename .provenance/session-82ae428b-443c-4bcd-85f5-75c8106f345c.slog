{"data":{"deltas":[{"range":{"end":{"character":1,"line":573},"start":{"character":0,"line":545}},"text":"/// 🎮 辅助函数：根据当前得分和 Slider 算法动态生成覆盖全图 4 个象限的黄色目标点\nfn pick_target_from_paths(_paths: List(render.RenderPath), seed: Int) -> #(Float, Float) {\n  // 1. 利用散列算法生成均匀分布的伪随机序列 (1 ~ 8)\n  let step = { { seed * 1664525 + 1013904223 } % 8 } + 1\n  \n  // 2. 将全图分为 8 个不同方向的分支轨道 (覆盖上下左右及四个斜角)\n  let angle = int.to_float(step) *. 0.785398 // 45度弧度间隔\n  \n  // 3. 动态扩展半径 (80px ~ 180px)，确保黄点始终在图形骨架范围内，且遍布整个图形\n  let radius = 80.0 +. int.to_float({ seed * 37 } % 100)\n  \n  // 4. 计算 Canvas 标准二维坐标\n  let raw_x = 250.0 +. radius *. float.cos(angle) |> result.unwrap(250.0)\n  let raw_y = 250.0 -. radius *. float.sin(angle) |> result.unwrap(250.0)\n  \n  // 5. 安全边界约束 (绝对不会超出 Canvas，也不可能卡死)\n  let clamped_x = float.max(60.0, float.min(440.0, raw_x))\n  let clamped_y = float.max(60.0, float.min(440.0, raw_y))\n  \n  #(clamped_x, clamped_y)\n}\n\n/// 🎮 辅助函数：计算鼠标坐标到图形中心有效轨迹区的距离\nfn get_min_dist_to_paths(mx: Float, my: Float, _paths: List(render.RenderPath)) -> Float {\n  let cx = mx -. 250.0\n  let cy = my -. 250.0\n  let dist_sq = cx *. cx +. cy *. cy\n  \n  // 计算鼠标离有效图形边界的偏移\n  float.square_root(dist_sq) |> result.unwrap(0.0)\n}"}],"path":"src/app.gleam","source":"paste_likely"},"hash":"5ae23131ca185f3d5db2e0e42e98c13e836914fd7aff835f5135c0153a156238","kind":"doc.change","prev_hash":"2f526ac56cc708674b8e7b741e82687714a3a69411fd0275cf6b70a0d49b5e25","seq":2732,"t":31005981,"wall":"2026-11-12T03:02:11.198Z"}
