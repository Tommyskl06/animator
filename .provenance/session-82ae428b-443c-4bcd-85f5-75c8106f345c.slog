{"data":{"deltas":[{"range":{"end":{"character":0,"line":291},"start":{"character":0,"line":273}},"text":"fn view_controls(model: Model) -> Element(Msg) {\n  html.div([attr.class(\"controls\")], [\n    html.div([attr.class(\"game-stats\")], [\n      html.span([attr.style([#(\"font-weight\", \"bold\")])], [\n        html.text(\"Score: \" <> int.to_string(model.score)),\n      ]),\n      html.span([attr.style([#(\"margin-left\", \"10px\"), #(\"color\", \"red\")])], [\n        html.text(\" | Health: \" <> int.to_string(model.health)),\n      ]),\n      html.button(\n        [\n          attr.class(\"icon-btn\"),\n          attr.style([#(\"margin-left\", \"10px\")]),\n          event.on_click(ResetGame),\n        ],\n        [html.text(\"Restart\")],\n      ),\n    ]),"}],"path":"src/app.gleam","source":"paste_likely"},"hash":"5364c1a007c25d8b474c98518b008e16dcc617508f6ed2f064e0114bfa35e457","kind":"doc.change","prev_hash":"fadc8c2f775a2bd887076c77a2e9478a1e5dceb82ef2afb6a9b27d1693db9fc1","seq":1118,"t":13421484,"wall":"2026-11-11T22:09:06.744Z"}
